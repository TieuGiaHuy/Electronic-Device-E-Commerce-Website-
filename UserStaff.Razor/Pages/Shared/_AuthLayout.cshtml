<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeZone Staff</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/techzone.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserStaff.Razor.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="vx-split">
        <aside class="vx-split-aside">
            <span class="vx-brand">
                <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
                <span class="vx-brand-tag">Staff</span>
            </span>

            <div class="vx-aside-body">
                <span class="vx-aside-eyebrow"><i class="bi bi-person-badge"></i> Staff portal</span>
                <h2>Keep the store running smoothly.</h2>
                <p>Everything your team needs to manage products, fulfil orders and moderate reviews.</p>
                <ul class="vx-aside-list">
                    <li>
                        <span class="ico"><i class="bi bi-box-seam"></i></span>
                        <div><strong>Products &amp; variants</strong><span>Update prices, stock and promotions.</span></div>
                    </li>
                    <li>
                        <span class="ico"><i class="bi bi-receipt"></i></span>
                        <div><strong>Order processing</strong><span>Move orders through each status.</span></div>
                    </li>
                    <li>
                        <span class="ico"><i class="bi bi-chat-square-text"></i></span>
                        <div><strong>Review moderation</strong><span>Keep customer feedback fair and clean.</span></div>
                    </li>
                </ul>
            </div>

            <div class="vx-aside-foot">&copy; @DateTime.Now.Year TimeZone. Staff access only.</div>
        </aside>

        <main class="vx-split-main">
            <div class="vx-auth-box">
                <div class="vx-auth-mobile-brand">
                    <span class="vx-brand">
                        <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
                        <span class="vx-brand-tag">Staff</span>
                    </span>
                </div>

                @RenderBody()

                <p class="vx-auth-foot">&copy; @DateTime.Now.Year TimeZone</p>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
