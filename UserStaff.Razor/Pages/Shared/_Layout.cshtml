<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeZone Staff</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/techzone.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserStaff.Razor.styles.css" asp-append-version="true" />
    <style>
        :root { --sidebar-width: 248px; }
        body { background: var(--vx-bg); margin-bottom: 0; }
        .app-shell { display: flex; min-height: 100vh; }

        /* ---------- Sidebar ---------- */
        .staff-sidebar { width: var(--sidebar-width); position: fixed; inset: 0 auto 0 0; z-index: 1030; background: var(--vx-surface); border-right: 1px solid var(--vx-line); }
        .staff-sidebar-inner { display: flex; flex-direction: column; height: 100%; padding: 1.25rem 1rem; overflow-y: auto; }
        .staff-sidebar-brand { display: flex; align-items: center; gap: .6rem; padding: .25rem .5rem 1.25rem; font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; color: var(--vx-ink); }
        .staff-role-badge { align-self: flex-start; margin: 0 .5rem 1rem; display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .65rem; border-radius: 999px; background: var(--vx-accent-soft); color: var(--vx-accent-active); font-size: .7rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
        .staff-nav { display: flex; flex-direction: column; gap: .15rem; flex: 1; }
        .staff-nav-link { display: flex; align-items: center; gap: .7rem; padding: .6rem .75rem; border-radius: var(--vx-radius-sm); color: var(--vx-text) !important; font-size: .9rem; font-weight: 500; text-decoration: none !important; transition: background .15s, color .15s; }
        .staff-nav-link i { font-size: 1.05rem; color: var(--vx-muted); transition: color .15s; }
        .staff-nav-link:hover { background: var(--vx-line-soft); color: var(--vx-ink) !important; }
        .staff-nav-link.active { background: var(--vx-accent-soft); color: var(--vx-accent-active) !important; }
        .staff-nav-link.active i { color: var(--vx-accent); }

        .staff-sidebar-footer { padding-top: 1rem; border-top: 1px solid var(--vx-line-soft); }
        .staff-user-link, .staff-logout-link { display: flex; align-items: center; gap: .6rem; padding: .55rem .75rem; border-radius: var(--vx-radius-sm); color: var(--vx-ink) !important; font-size: .88rem; font-weight: 500; text-decoration: none !important; }
        .staff-user-link:hover, .staff-logout-link:hover { background: var(--vx-line-soft); }
        .staff-user-link i { font-size: 1.4rem; color: var(--vx-muted); }

        /* ---------- Main column ---------- */
        .staff-main-column { flex: 1; min-width: 0; margin-left: var(--sidebar-width); display: flex; flex-direction: column; min-height: 100vh; }
        .staff-topbar { position: sticky; top: 0; z-index: 1020; display: flex; align-items: center; justify-content: space-between; height: 60px; padding: 0 1.75rem; background: rgba(255,255,255,.86); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--vx-line); }
        .staff-topbar-title { font-weight: 600; font-size: 1rem; color: var(--vx-ink); }
        .staff-mobile-toggle { display: none; border: 0; color: var(--vx-ink); }
        .staff-content { flex: 1; padding: 1.5rem 1.75rem; }
        .staff-content-card { background: var(--vx-surface); border: 1px solid var(--vx-line); border-radius: var(--vx-radius-lg); box-shadow: var(--vx-shadow-sm); padding: 1.5rem; }
        .staff-footer { padding: 1rem 1.75rem; font-size: .8rem; color: var(--vx-muted); border-top: 1px solid var(--vx-line); background: var(--vx-surface); }

        @@media (max-width: 991.98px) {
            .staff-sidebar { transform: translateX(-100%); transition: transform .2s ease; box-shadow: var(--vx-shadow-lg); }
            .staff-sidebar.show { transform: none; }
            .staff-main-column { margin-left: 0; }
            .staff-mobile-toggle { display: inline-flex; }
        }
    </style>
</head>
<body>
    <div class="app-shell">
        <!-- ============ Sidebar ============ -->
        <aside class="staff-sidebar" id="staffSidebar">
            <div class="staff-sidebar-inner">
                <div class="staff-sidebar-brand">
                    <span class="vx-brand-mark"><i class="bi bi-watch"></i></span>
                    <span>Time<span class="vx-brand-zone">Zone</span></span>
                </div>

                <span class="staff-role-badge"><i class="bi bi-person-badge"></i> Staff</span>

                <nav class="staff-nav">
                    <a class="staff-nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house-door"></i> Home</a>
                    <a class="staff-nav-link" asp-area="" asp-page="/Products/Index"><i class="bi bi-box-seam"></i> Product Variants</a>
                    <a class="staff-nav-link" asp-area="" asp-page="/Reviews/Index"><i class="bi bi-chat-square-text"></i> Reviews</a>
                    <a class="staff-nav-link" asp-area="" asp-page="/Orders/Index"><i class="bi bi-receipt"></i> Order Processing</a>
                </nav>

                <div class="staff-sidebar-footer">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown dropup">
                            <a class="staff-user-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="text-truncate">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu mb-2">
                                <li><a class="dropdown-item" asp-page="/Profile/Index"><i class="bi bi-person me-2"></i> Profile</a></li>
                                <li><a class="dropdown-item" asp-page="/Auth/Logout"><i class="bi bi-box-arrow-right me-2"></i> Log out</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="staff-logout-link" asp-page="/Auth/Login"><i class="bi bi-box-arrow-in-right"></i> Log in</a>
                    }
                </div>
            </div>
        </aside>

        <!-- ============ Main column ============ -->
        <div class="staff-main-column">
            <header class="staff-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm staff-mobile-toggle" type="button" onclick="document.getElementById('staffSidebar').classList.toggle('show')">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="staff-topbar-title">@ViewData["Title"]</span>
                </div>
            </header>

            <div class="staff-content">
                <main role="main" class="staff-content-card">
                    @RenderBody()
                </main>
            </div>

            <footer class="staff-footer d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year TimeZone. Operations management</span>
                <span>Access level: Warehouse / Sales Staff</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // highlight the sidebar link that matches the current section
        (function () {
            var path = location.pathname.toLowerCase();
            document.querySelectorAll('.staff-nav-link').forEach(function (a) {
                var href = (a.getAttribute('href') || '').toLowerCase();
                var isHome = href === '/' || href === '';
                var match = isHome ? (path === '/' || path === '/index')
                                   : path.startsWith(href.replace(/\/index$/, ''));
                if (match) a.classList.add('active');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
