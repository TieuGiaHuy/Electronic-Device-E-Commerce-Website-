@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="vx-page-head">
    <div>
        <h2>Welcome back, @User.Identity?.Name</h2>
        <p>Here is what's happening in the store today.</p>
    </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-3 col-6">
        <div class="vx-stat">
            <div class="d-flex justify-content-between align-items-start">
                <span class="vx-stat-label">Products</span>
                <span class="vx-stat-icon"><i class="bi bi-box-seam"></i></span>
            </div>
            <div class="vx-stat-value">@Model.TotalProducts</div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="vx-stat">
            <div class="d-flex justify-content-between align-items-start">
                <span class="vx-stat-label">Pending orders</span>
                <span class="vx-stat-icon" style="background: var(--vx-warning-soft); color: var(--vx-warning);"><i class="bi bi-hourglass-split"></i></span>
            </div>
            <div class="vx-stat-value">@Model.PendingOrders</div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="vx-stat">
            <div class="d-flex justify-content-between align-items-start">
                <span class="vx-stat-label">Completed revenue</span>
                <span class="vx-stat-icon" style="background: var(--vx-success-soft); color: var(--vx-success);"><i class="bi bi-cash-stack"></i></span>
            </div>
            <div class="vx-stat-value">@Model.TotalRevenue.ToString("C0", new CultureInfo("vi-VN"))</div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="vx-stat">
            <div class="d-flex justify-content-between align-items-start">
                <span class="vx-stat-label">Flagged reviews</span>
                <span class="vx-stat-icon" style="background: var(--vx-info-soft); color: var(--vx-info);"><i class="bi bi-flag"></i></span>
            </div>
            <div class="vx-stat-value">@Model.FlaggedReviews <span class="fs-6 text-muted fw-normal">/ @Model.TotalReviews</span></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent orders -->
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold m-0">Recent orders</h5>
            <a asp-page="/Orders/Index" class="btn btn-sm btn-outline-secondary">View all</a>
        </div>
        @if (!Model.RecentOrders.Any())
        {
            <p class="text-muted">No orders yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td class="small">@order.OrderId.ToString().Substring(0, 8)</td>
                                <td title="Customer ID: @order.CustomerId">@(string.IsNullOrWhiteSpace(order.CustomerName) ? $"Customer #{order.CustomerId}" : order.CustomerName)</td>
                                <td class="fw-semibold">@order.TotalAmount.ToString("C0", new CultureInfo("vi-VN"))</td>
                                <td><span class="badge @Model.GetStatusBadgeClass(order.Status)">@order.Status</span></td>
                                <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
