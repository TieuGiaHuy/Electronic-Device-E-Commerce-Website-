@page
@model Staff.Razor.Pages.ProductVariants.CreateVariantsModel

@{
    ViewData["Title"] = "Auto-Generate Product Variants";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <a asp-page="./Index" asp-route-productId="@Model.ProductId" class="ds-back-btn shadow-sm" title="Back">
                <i class="bi bi-arrow-left fs-5 lh-1"></i>
            </a>
            <h5 class="mb-0"><i class="bi bi-watch me-2"></i> Auto-Generate Variants Matrix</h5>
        </div>
        <div class="card-body">
            <form method="post" id="variantsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductId" />
                <div class="row">
                    <div class="col-md-4 border-end">
                        <h6 class="text-secondary fw-bold text-uppercase mb-3">1. Enter Attributes</h6>
                        <p class="small text-muted">Separate multiple values with commas (e.g., Black, Silver, Gold). Every attribute with several values multiplies the number of variants; an attribute with one value is applied to all variants.</p>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Colors <span class="text-danger">*</span></label>
                            <input type="text" id="inputColors" class="form-control attr-input" placeholder="e.g., Black, White, Silver" />
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="traditional">Mechanical / Quartz template</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="smart">Smartwatch template</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-preset="strap">Strap template</button>
                        </div>

                        <datalist id="attrNameSuggestions">
                            @foreach (var name in DAL.Utilities.WatchAttributeNames.All)
                            {
                                <option value="@name"></option>
                            }
                        </datalist>

                        <div id="dimensionRows" class="mb-2"></div>
                        <button type="button" class="btn btn-sm btn-outline-primary mb-4" id="btnAddDimension">
                            <i class="bi bi-plus-lg me-1"></i> Add attribute
                        </button>

                        <div class="p-3 bg-light rounded border border-secondary border-opacity-25 mb-4">
                            <h6 class="text-dark fw-bold small text-uppercase mb-3"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Fill Default Values</h6>

                            <div class="mb-2">
                                <label class="form-label small fw-bold text-muted mb-1">Default Price (₫)</label>
                                <input type="number" id="quickPrice" class="form-control form-control-sm" placeholder="0" min="0" />
                            </div>

                            <div class="mb-0">
                                <label class="form-label small fw-bold text-muted mb-1">Default Stock</label>
                                <input type="number" id="quickStock" class="form-control form-control-sm" placeholder="0" min="0" />
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="button" class="btn btn-outline-secondary" id="btnClearAll">
                                <i class="bi bi-trash3 me-1"></i> Clear Inputs
                            </button>
                        </div>
                    </div>

                    <div class="col-md-8 ps-md-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="text-secondary fw-bold text-uppercase mb-0">2. Generated Variants Matrix</h6>
                            <span class="badge bg-primary fs-6" id="lblTotalVariants">Total: 0 variants</span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="table-responsive style-scroll" style="max-height: 550px;">
                            <table class="table table-bordered align-middle text-center" id="matrixTable">
                                <thead class="table-light sticky-top">
                                    <tr id="matrixHeadRow">
                                        <th>Color</th>
                                        <th style="width: 150px;">Price (₫) <span class="text-danger">*</span></th>
                                        <th style="width: 100px;">Stock <span class="text-danger">*</span></th>
                                    </tr>
                                </thead>
                                <tbody id="matrixBody">
                                    <tr>
                                        <td colspan="3" class="text-muted py-4">Enter colors and attribute values on the left to generate the matrix.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-5" id="btnSaveMatrix" disabled>
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Save All Variants
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .style-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .style-scroll::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .style-scroll::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 4px;
    }

    .sticky-top {
        top: -1px;
        z-index: 10;
    }
</style>

@section Scripts {
    <script>
        const PRESETS = {
            traditional: [
                ['Bộ máy', ''], ['Chất liệu mặt kính', ''], ['Chất liệu dây', ''],
                ['Đường kính mặt', ''], ['Chống nước', '']
            ],
            smart: [
                ['Kích thước màn hình', ''], ['Loại màn hình', ''], ['Dung lượng pin', ''],
                ['Hệ điều hành', ''], ['Kết nối', ''], ['Tương thích thiết bị', '']
            ],
            strap: [
                ['Chất liệu', ''], ['Độ rộng dây', ''], ['Loại khóa', '']
            ]
        };
        const MAX_VARIANTS = 300;

        function escapeHtml(text) {
            return String(text).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function splitValues(raw) {
            const seen = new Set();
            const result = [];
            raw.split(',').map(s => s.trim()).filter(s => s.length > 0).forEach(v => {
                const key = v.toLowerCase();
                if (!seen.has(key)) { seen.add(key); result.push(v); }
            });
            return result;
        }

        function addDimensionRow(name, values) {
            const wrap = document.getElementById('dimensionRows');
            const row = document.createElement('div');
            row.className = 'border rounded p-2 mb-2 dimension-row';
            row.innerHTML = `
                <div class="d-flex gap-2 mb-1">
                    <input type="text" class="form-control form-control-sm dim-name" list="attrNameSuggestions" placeholder="Attribute name (e.g., Bộ máy)" value="${escapeHtml(name || '')}" />
                    <button type="button" class="btn btn-sm btn-outline-danger dim-remove" title="Remove"><i class="bi bi-x-lg"></i></button>
                </div>
                <input type="text" class="form-control form-control-sm dim-values" placeholder="Values, separated by commas" value="${escapeHtml(values || '')}" />`;
            row.querySelector('.dim-name').addEventListener('input', generateMatrix);
            row.querySelector('.dim-values').addEventListener('input', generateMatrix);
            row.querySelector('.dim-remove').addEventListener('click', () => { row.remove(); generateMatrix(); });
            wrap.appendChild(row);
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('inputColors').addEventListener('input', generateMatrix);
            document.getElementById('btnAddDimension').addEventListener('click', () => addDimensionRow('', ''));
            document.querySelectorAll('[data-preset]').forEach(btn => btn.addEventListener('click', () => {
                document.getElementById('dimensionRows').innerHTML = '';
                PRESETS[btn.dataset.preset].forEach(p => addDimensionRow(p[0], p[1]));
                generateMatrix();
            }));

            // Lắng nghe sự kiện gõ trên các ô điền nhanh (Quick Fill) để đồng bộ xuống dưới bảng
            document.getElementById('quickPrice').addEventListener('input', syncQuickFill);
            document.getElementById('quickStock').addEventListener('input', syncQuickFill);

            document.getElementById('btnClearAll').addEventListener('click', function () {
                document.getElementById('inputColors').value = '';
                document.getElementById('dimensionRows').innerHTML = '';
                document.getElementById('quickPrice').value = '';
                document.getElementById('quickStock').value = '';
                generateMatrix();
            });

            addDimensionRow('', '');
        });

        function generateMatrix() {
            const colors = splitValues(document.getElementById('inputColors').value);

            // Mỗi dòng thuộc tính có Tên và ít nhất một Giá trị sẽ trở thành một "chiều" của ma trận
            const dims = [];
            document.querySelectorAll('.dimension-row').forEach(row => {
                const name = row.querySelector('.dim-name').value.trim();
                const values = splitValues(row.querySelector('.dim-values').value);
                if (name && values.length > 0) dims.push({ name, values });
            });

            if (colors.length === 0) {
                resetTable();
                return;
            }

            // Tích Descartes của màu sắc và từng thuộc tính
            let combos = colors.map(c => ({ color: c, values: [] }));
            dims.forEach(d => {
                const next = [];
                combos.forEach(c => d.values.forEach(v => next.push({ color: c.color, values: [...c.values, v] })));
                combos = next;
            });

            const lblTotal = document.getElementById('lblTotalVariants');
            if (combos.length > MAX_VARIANTS) {
                resetTable();
                lblTotal.innerText = `Too many variants (${combos.length}). Maximum ${MAX_VARIANTS}.`;
                lblTotal.className = "badge bg-danger fs-6";
                return;
            }

            // Cập nhật tiêu đề bảng theo các thuộc tính hiện có
            const head = document.getElementById('matrixHeadRow');
            head.innerHTML = '<th>Color</th>' + dims.map(d => `<th>${escapeHtml(d.name)}</th>`).join('') +
                '<th style="width: 150px;">Price (₫) <span class="text-danger">*</span></th>' +
                '<th style="width: 100px;">Stock <span class="text-danger">*</span></th>';

            const matrixBody = document.getElementById('matrixBody');
            const btnSave = document.getElementById('btnSaveMatrix');
            const defaultPrice = document.getElementById('quickPrice').value;
            const defaultStock = document.getElementById('quickStock').value;

            matrixBody.innerHTML = '';
            combos.forEach((combo, i) => {
                let cells = `<td><input type="hidden" name="Variants[${i}].Color" value="${escapeHtml(combo.color)}" />${escapeHtml(combo.color)}</td>`;
                dims.forEach((d, j) => {
                    cells += `<td>
                        <input type="hidden" name="Variants[${i}].Attributes[${j}].Name" value="${escapeHtml(d.name)}" />
                        <input type="hidden" name="Variants[${i}].Attributes[${j}].Value" value="${escapeHtml(combo.values[j])}" />
                        ${escapeHtml(combo.values[j])}</td>`;
                });
                cells += `
                    <td>
                        <div class="input-group input-group-sm">
                            <input type="number" name="Variants[${i}].Price" class="form-control text-end matrix-price" value="${defaultPrice}" placeholder="0" min="0" required />
                            <span class="input-group-text">₫</span>
                        </div>
                    </td>
                    <td>
                        <input type="number" name="Variants[${i}].StockQuantity" class="form-control form-control-sm text-center matrix-stock" value="${defaultStock}" placeholder="0" min="0" required />
                    </td>`;
                const tr = document.createElement('tr');
                tr.innerHTML = cells;
                matrixBody.appendChild(tr);
            });

            lblTotal.innerText = `Total: ${combos.length} variants`;
            lblTotal.className = "badge bg-success fs-6";
            btnSave.disabled = combos.length === 0;
        }

        // Đồng bộ dữ liệu từ Quick Fill xuống toàn bộ ma trận khi đang gõ
        function syncQuickFill() {
            const defaultPrice = document.getElementById('quickPrice').value;
            const defaultStock = document.getElementById('quickStock').value;
            document.querySelectorAll('.matrix-price').forEach(input => { input.value = defaultPrice; });
            document.querySelectorAll('.matrix-stock').forEach(input => { input.value = defaultStock; });
        }

        function resetTable() {
            document.getElementById('matrixHeadRow').innerHTML =
                '<th>Color</th><th style="width: 150px;">Price (₫) <span class="text-danger">*</span></th><th style="width: 100px;">Stock <span class="text-danger">*</span></th>';
            document.getElementById('matrixBody').innerHTML = `<tr><td colspan="3" class="text-muted py-4">Enter colors and attribute values on the left to generate the matrix.</td></tr>`;
            document.getElementById('btnSaveMatrix').disabled = true;
            const lblTotal = document.getElementById('lblTotalVariants');
            lblTotal.innerText = 'Total: 0 variants';
            lblTotal.className = "badge bg-primary fs-6";
        }
    </script>
}
