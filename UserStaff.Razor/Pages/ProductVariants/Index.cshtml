@page
@model UserStaff.Razor.Pages.ProductVariants.IndexModel
@{
    ViewData["Title"] = "Quản lý biến thể sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 fw-bold border-start border-4 ps-3 border-danger">Danh sách Biến thể (Variants)</h2>
    <a asp-page="Create" asp-route-productId="@Model.productId" class="btn btn-danger px-4 shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Thêm biến thể
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-4">SKU</th>
                        <th>Cấu hình cơ bản</th>
                        <th>Thông số kỹ thuật</th>
                        <th class="text-end">Giá bán (VNĐ)</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductVariants.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu biến thể.</td></tr>
                    }
                    @foreach (var variant in Model.ProductVariants)
                    {
                        <tr class="border-bottom">
                            <td class="px-4">
                                <div class="fw-bold text-dark">@variant.ProductCode</div>
                                <div class="text-muted small">@variant.Sku</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary me-1">@variant.Color</span>
                                <span class="badge bg-info text-dark">@variant.Storage</span>
                            </td>
                            <td>
                                <div class="small">
                                    @if (!string.IsNullOrEmpty(variant.Ram))
                                    {
                                        <span class="d-block"><b>RAM:</b> @variant.Ram</span>
                                    }
                                    @if (!string.IsNullOrEmpty(variant.Cpu))
                                    {
                                        <span class="d-block"><b>CPU:</b> @variant.Cpu</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end fw-bold text-danger">@variant.Price.ToString("N0") đ</td>
                            <td class="text-center">
                                @if (variant.StockQuantity > 10)
                                {
                                    <span class="badge bg-success rounded-pill px-3">@variant.StockQuantity</span>
                                }
                                else if (variant.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3">@variant.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Hết hàng</span>
                                }
                            </td>
                            <td class="text-center px-4">
                                <button type="button" class="btn btn-outline-info btn-sm rounded-circle px-2"
                                        data-id="@variant.ProductVariantId"
                                        data-sku="@variant.Sku"
                                        title="Nhập thêm hàng">
                                    <i class="bi bi-box-seam"></i>
                                </button>
                                <a asp-page="./Update" asp-route-id="@variant.ProductVariantId" asp-route-productId="@Model.productId" class="btn btn-outline-primary btn-sm rounded-circle px-2" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle px-2 btn-delete"
                                        data-id="@variant.ProductVariantId"
                                        data-sku="@variant.Sku"
                                        title="Xóa biến thể">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- POPUP XÁC NHẬN XÓA -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-shield-fill-exclamation text-danger me-2"></i>Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-trash3 text-danger display-4 mb-3 d-block"></i>
                <p class="fs-5 mb-1 fw-semibold">Bạn có chắc muốn xóa biến thể này?</p>
                <p class="text-muted small">Mã sản phẩm: <b id="lblDeleteSku" class="text-danger"></b></p>
                <p class="text-muted small mb-0 text-decoration-underline">Lưu ý:</p>
                <span class="text-secondary small d-block">Hệ thống sẽ thực hiện chức năng xóa mềm.</span>
            </div>
            <div class="modal-footer bg-light border-top-0 d-flex justify-content-center gap-2 py-3">
                <button type="button" class="btn btn-light border px-4 animate-btn" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnConfirmDelete" class="btn btn-danger px-4">Đồng ý xóa</button>
            </div>
        </div>
    </div>
</div>

<!-- POPUP NHẬP THÊM HÀNG -->
<div class="modal fade" id="stockInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom-0 py-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-box-seam-fill text-info me-2"></i>Nhập kho biến thể
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small mb-3 text-center">
                    Mã SKU: <b id="lblStockInSku" class="text-info"></b>
                </p>

                <div class="form-group mb-2">
                    <label for="txtQuantity" class="fw-semibold small mb-1">Số lượng nhập thêm:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-secondary"><i class="bi bi-plus-lg"></i></span>
                        <input type="number" id="txtQuantity" class="form-control text-center fw-bold text-dark" min="1" value="1" oninput="this.value = !!this.value && Math.abs(this.value) >= 1 ? Math.abs(this.value) : 1" />
                    </div>
                    <span id="quantityError" class="text-danger small d-none">Số lượng phải lớn hơn hoặc bằng 1!</span>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 d-flex justify-content-center gap-2 py-3">
                <button type="button" class="btn btn-light border px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnConfirmStockIn" class="btn btn-info text-dark fw-bold px-4">Xác nhận nhập</button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST THÔNG BÁO TRẠNG THÁI -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
    <div id="statusToast" class="toast align-items-center text-white border-0 shadow rounded-3" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 fw-semibold">
                <i id="toastIcon" class="bi fs-5"></i>
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- FORM CHỨA TOKEN BẢO MẬT BẮT BUỘC CỦA .NET RAZOR PAGES -->
<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            let idToDelete = null;
            let idToStockIn = null;
            let currentRow = null;

            // 1. Lắng nghe sự kiện click nút Thùng rác
            $('.btn-delete').on('click', function () {
                idToDelete = $(this).data('id');
                let sku = $(this).data('sku');
                currentRow = $(this).closest('tr'); // Giữ lại dòng vừa click để xóa hiệu ứng

                $('#lblDeleteSku').text(sku);
                $('#deleteModal').modal('show'); // Bật popup
            });

            // 2. Lắng nghe sự kiện nhấn "Đồng ý xóa" trong popup
            $('#btnConfirmDelete').on('click', function () {
                if (!idToDelete) return;

                // Lấy Token chống tấn công giả mạo (CSRF)
                let token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '?handler=Delete', // Gọi trực tiếp đến hàm OnPostDeleteAsync
                    type: 'POST',
                    data: { id: idToDelete },
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        $('#deleteModal').modal('hide'); // Đóng popup nhanh

                        if (response.success) {
                            showToast('success', response.message);
                            // Tạo hiệu ứng mờ dần rồi xóa hẳn dòng đó trên giao diện mà không cần reload
                            currentRow.fadeOut(400, function () { $(this).remove(); });
                        } else {
                            showToast('danger', response.message);
                        }
                    },
                    error: function () {
                        $('#deleteModal').modal('hide');
                        showToast('danger', 'Không thể kết nối tới hệ thống. Vui lòng thử lại!');
                    }
                });
            });


            // lắng nghe khi click vào nút nhập hàng
            $('.btn-outline-info').on('click', function () {
                idToStockIn = $(this).data('id')
                let sku = $(this).data('sku');
                currentRow = $(this).closest('tr');

                $('#lblStockInSku').text(sku);
                $('#txtQuantity').val(1); // reset số lượng về 1
                $('#quantiyError').addClass('d-none');
                $('#stockInModal').modal('show');
            });

            $('#btnConfirmStockIn').on('click', function () {
                if (!idToStockIn) return;
                let qty = parseInt($('#txtQuantity').val());

                if (isNaN(qty) || qty < 1) {
                    $('#quantityError').removeClass('d-none');
                    return;
                }

                // Lấy Token chống tấn công giả mạo (CSRF)
                let token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '?handler=StockIn', // Gọi trực tiếp đến hàm OnPostStockInAsync
                    type: 'POST',
                    data: { id: idToStockIn, increaseAmount: qty },
                    headers: { "RequestVerificationToken": token },
                    success: function (response) {
                        $('#stockInModal').modal('hide'); // Đóng popup nhanh

                        if (response.success) {
                            location.reload(); // Reload lại trang để cập nhật số lượng tồn kho mới nhất
                        } else {
                            showToast('danger', response.message);
                        }
                    },
                    error: function () {
                        $('#stockInModal').modal('hide');
                        showToast('danger', 'Không thể kết nối tới hệ thống. Vui lòng thử lại!');
                    }
                });
            });

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showToast('success', '@Html.Raw(TempData["SuccessMessage"])');
                </text>
            } else if (TempData["ErrorMessage"] != null)
            {
                <text>
                showToast('danger', '@Html.Raw(TempData["ErrorMessage"])');
                </text>
            }

            // Hàm xử lý hiển thị Toast tùy biến theo trạng thái
            function showToast(status, message) {
                let toastEl = $('#statusToast');
                let iconEl = $('#toastIcon');

                toastEl.removeClass('bg-success bg-danger');
                iconEl.removeClass('bi-check-circle-fill bi-x-circle-fill');

                if (status === 'success') {
                    toastEl.addClass('bg-success');
                    iconEl.addClass('bi-check-circle-fill');
                } else {
                    toastEl.addClass('bg-danger');
                    iconEl.addClass('bi-x-circle-fill');
                }

                $('#toastMessage').text(message);
                let bsToast = new bootstrap.Toast(toastEl[0]);
                bsToast.show();
            }
        });
    </script>
}