@page
@model Staff.Razor.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Staff sign in";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="vx-auth-title">
    <h1>Staff sign in</h1>
    <p>Sign in to manage products, orders and reviews.</p>
</div>

<form method="post" novalidate>
    <div asp-validation-summary="All" class="vx-flash err mb-3"></div>

    <div class="vx-field">
        <label asp-for="Input.Email">Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <input asp-for="Input.Email" class="form-control" placeholder="you@company.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="vx-field">
        <label asp-for="Input.Password">Password</label>
        <div class="vx-input">
            <i class="bi bi-lock lead"></i>
            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Enter your password" autocomplete="current-password" />
            <button type="button" class="vx-pw-toggle" data-target="Input_Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="vx-auth-row">
        <span></span>
        <a asp-page="/Auth/ForgotPassword" class="auth-link">Forgot password?</a>
    </div>

    <button type="submit" class="btn btn-primary">Sign in</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
