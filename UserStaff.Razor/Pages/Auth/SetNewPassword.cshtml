@page
@model Staff.Razor.Pages.Auth.SetNewPasswordModel
@{
    ViewData["Title"] = "Set new password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<a asp-page="/Auth/Login" class="vx-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>

<div class="vx-auth-title">
    <h1>Set a new password</h1>
    <p>Choose a strong password for your staff account.</p>
</div>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="vx-flash err mb-3"></div>
    <input type="hidden" asp-for="Email" />

    <div class="vx-field">
        <label for="Password">New password</label>
        <div class="vx-input">
            <i class="bi bi-lock lead"></i>
            <input asp-for="Password" class="form-control" type="password" id="Password" placeholder="At least 8 characters" autocomplete="new-password" />
            <button type="button" class="vx-pw-toggle" data-target="Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <div class="vx-strength" data-for="Password"><div class="bars"><span></span><span></span><span></span><span></span></div><small></small></div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="vx-field">
        <label for="ConfirmPassword">Confirm password</label>
        <div class="vx-input">
            <i class="bi bi-lock-fill lead"></i>
            <input asp-for="ConfirmPassword" class="form-control" type="password" id="ConfirmPassword" placeholder="Re-enter the new password" autocomplete="new-password" />
            <button type="button" class="vx-pw-toggle" data-target="ConfirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
