@page
@model Staff.Razor.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<a asp-page="/Auth/Login" class="vx-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>

<div class="vx-auth-title">
    <h1>Forgot your password?</h1>
    <p>Enter your staff email and we'll help you set a new password.</p>
</div>

<form method="post" novalidate>
    <div asp-validation-summary="All" class="vx-flash err mb-3"></div>

    <div class="vx-field">
        <label for="Email">Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <input asp-for="Email" class="form-control" id="Email" placeholder="you@company.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary">Continue</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
