@page "/Auth/AccessDenied"
@{
    ViewData["Title"] = "Access denied";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="vx-auth-icon warn"><i class="bi bi-shield-lock"></i></div>

<div class="vx-auth-title">
    <h1>Access denied</h1>
    <p>Your account doesn't have the Staff or Admin permission needed to view this page.</p>
</div>

<a href="/Auth/Login" class="btn btn-primary">Back to sign in</a>
