@page "/Auth/AccessDenied"
@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
}

<div class="text-center">
    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 3rem;"></i>
    <h4 class="fw-bold mt-3">Bạn không có quyền truy cập trang này</h4>
    <p class="text-muted small">Tài khoản của bạn không đủ quyền (Staff/Admin) để xem nội dung này.</p>
    <a href="/Auth/Login" class="btn btn-auth-primary px-4 py-2 mt-2">Về trang đăng nhập</a>
</div>
