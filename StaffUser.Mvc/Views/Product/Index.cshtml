@using System.Globalization
@using BLL.DTOs.Product.Customer
@using BLL.DTOs.ProductReview
@using BLL.DTOs.ProductVariant.Customer
@model ProductCustomerDto

@{
    ViewData["Title"] = Model?.ProductName ?? "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var inv = CultureInfo.InvariantCulture;

    // Valid variants, cheapest first
    var activeVariants = Model?.ProductVariants?.Where(v => !v.IsDeleted).OrderBy(v => v.Price).ToList()
        ?? new List<ProductVariantCustomerDto>();
    var defaultVariant = activeVariants.FirstOrDefault(v => v.StockQuantity > 0) ?? activeVariants.FirstOrDefault();

    // Data sent to the client-side variant picker.
    // Attrs = specifications of the variant as a list of { name, value }.
    var variantsForJs = activeVariants.Select(v => new
    {
        v.ProductVariantId,
        v.Sku,
        v.Color,
        Attrs = v.Attributes
            .Where(a => !string.IsNullOrWhiteSpace(a.Name))
            .Select(a => new { Name = a.Name!.Trim(), Value = (a.Value ?? string.Empty).Trim() })
            .ToList(),
        v.Price,
        FinalPrice = v.GetPrice(),
        v.StockQuantity,
        v.ImageUrl
    }).ToList();

    // All specification names, in display order (first variant that has them decides the order)
    var attributeNames = activeVariants
        .SelectMany(v => v.Attributes)
        .Where(a => !string.IsNullOrWhiteSpace(a.Name))
        .Select(a => a.Name!.Trim())
        .Distinct()
        .ToList();

    // Values per specification: a specification with more than one value becomes a selectable option group
    var attributeValues = attributeNames.ToDictionary(
        n => n,
        n => activeVariants
            .Select(v => v.Attributes.FirstOrDefault(a => string.Equals(a.Name?.Trim(), n, StringComparison.Ordinal))?.Value?.Trim())
            .Where(x => !string.IsNullOrEmpty(x))
            .Select(x => x!)
            .Distinct()
            .ToList());
    var optionAttributeNames = attributeNames.Where(n => attributeValues[n].Count > 1).ToList();

    var uniqueColors = activeVariants.Where(v => !string.IsNullOrEmpty(v.Color)).Select(v => v.Color!).Distinct().ToList();

    // Dimensions the customer can pick: color first, then every attribute that differs between variants
    const string ColorKey = "__color";
    var dimensionKeys = new List<string>();
    if (uniqueColors.Any()) dimensionKeys.Add(ColorKey);
    dimensionKeys.AddRange(optionAttributeNames);

    // CSS color for swatches (Vietnamese and English names)
    var swatchMap = new Dictionary<string, string>
    {
        ["đen"] = "#111111", ["trắng"] = "#f5f5f5", ["bạc"] = "#c0c0c0", ["vàng"] = "#d4af37",
        ["vàng hồng"] = "#e0a899", ["hồng"] = "#f4a6b7", ["đỏ"] = "#c62828", ["nâu"] = "#6d4c41",
        ["xám"] = "#808080", ["xanh navy"] = "#1f2a56", ["xanh dương"] = "#2f6fdb", ["xanh lá"] = "#2e7d32",
        ["xanh quân đội"] = "#4b5320", ["đen titanium"] = "#2b2b2b", ["titanium"] = "#8a8d8f"
    };

    string SpecIcon(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("bộ máy")) return "bi-gear-wide-connected";
        if (n.Contains("kính")) return "bi-gem";
        if (n.Contains("chống nước")) return "bi-droplet";
        if (n.Contains("đường kính")) return "bi-circle";
        if (n.Contains("dây") || n.Contains("khóa")) return "bi-link-45deg";
        if (n.Contains("màn hình") || n.Contains("hiển thị")) return "bi-smartwatch";
        if (n.Contains("pin")) return "bi-battery-full";
        if (n.Contains("hệ điều hành")) return "bi-cpu";
        if (n.Contains("kết nối")) return "bi-bluetooth";
        if (n.Contains("tương thích")) return "bi-phone";
        if (n.Contains("chất liệu")) return "bi-gem";
        return "bi-info-circle";
    }

    var reviews = ViewBag.Reviews as List<ProductReviewDto> ?? new List<ProductReviewDto>();
    var currentUserEmail = ViewBag.CurrentUserEmail as string;
    var myReview = ViewBag.MyReview as ProductReviewDto;

    var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0.0;

    var defaultFinalPrice = defaultVariant?.GetPrice() ?? 0m;
    var defaultIsOnSale = defaultVariant != null && defaultVariant.Price > 0 && defaultFinalPrice < defaultVariant.Price;
    var defaultDiscount = defaultIsOnSale ? (int)Math.Round((1 - defaultFinalPrice / defaultVariant!.Price) * 100) : 0;
    var heroImage = defaultVariant?.ImageUrl ?? (string.IsNullOrEmpty(Model?.ImageUrl) ? "/images/default-product.png" : Model!.ImageUrl);
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />
}

@if (Model == null)
{
    <div class="alert alert-danger">Product not found or has been deleted.</div>
}
else
{
    <!-- ============ HERO ============ -->
    <section class="tz-hero">
        <div class="container tz-hero-inner">
            <div class="tz-hero-copy">
                <nav class="tz-crumbs" aria-label="Breadcrumb">
                    <a href="@Url.Action("Index", "Home")">Home</a>
                    <span class="sep">/</span>
                    <a href="@Url.Action("Index", "Home", new { categoryId = Model.CategoryId })">@Model.CategoryName</a>
                    <span class="sep">/</span>
                    <span class="current">@Model.ProductName</span>
                </nav>

                <span class="tz-eyebrow"><i class="bi bi-patch-check-fill"></i> @Model.Brand</span>
                <h1 class="tz-title">@Model.ProductName</h1>

                <div class="tz-meta">
                    <a href="#reviews" class="d-inline-flex align-items-center gap-2">
                        <span class="tz-stars" style="--rating:@avgRating.ToString("0.0", inv)"></span>
                        <span>@(reviews.Any() ? avgRating.ToString("0.0", inv) : "No ratings yet") @(reviews.Any() ? $"({reviews.Count})" : "")</span>
                    </a>
                    <span class="dot"></span>
                    <span>@Model.CategoryName</span>
                    @if (defaultVariant != null)
                    {
                        <span class="dot"></span>
                        <span>SKU <strong id="variantSkuText" class="text-uppercase">@defaultVariant.Sku</strong></span>
                    }
                </div>

                @if (defaultVariant != null)
                {
                    <div class="tz-price-row">
                        <span class="tz-price"><span id="variantPriceText">@defaultFinalPrice.ToString("N0")</span><small id="variantCurrency">₫</small></span>
                        <span id="variantOldPriceText" class="tz-price-old @(defaultIsOnSale ? "" : "d-none")">@defaultVariant.Price.ToString("N0") ₫</span>
                        <span id="variantSaveText" class="tz-save @(defaultIsOnSale ? "" : "d-none")">Save @(defaultIsOnSale ? (defaultVariant.Price - defaultFinalPrice).ToString("N0") : "0") ₫</span>
                    </div>

                    <a href="#configure" class="tz-hero-cta">Choose your configuration <i class="bi bi-arrow-down"></i></a>
                }
            </div>

            <div class="tz-hero-stage">
                <div class="tz-ring r1"></div>
                <div class="tz-ring r2"></div>
                @if (defaultVariant != null)
                {
                    <span id="variantDiscountBadge" class="tz-sale-badge @(defaultIsOnSale ? "" : "d-none")">-@defaultDiscount%</span>
                }
                <img id="variantMainImage" src="@heroImage" alt="@Model.ProductName" />
            </div>
        </div>
    </section>

    @if (defaultVariant != null)
    {
        <!-- ============ CONFIGURATOR ============ -->
        <section id="configure" class="tz-configurator">
            <div class="tz-config-options">
                <h2 class="tz-config-head">Build your configuration</h2>

                @if (uniqueColors.Any())
                {
                    <div class="tz-opt-group">
                        <span class="tz-opt-label">Color</span>
                        <div class="tz-opt-row" id="colorGroup">
                            @foreach (var color in uniqueColors)
                            {
                                var key = color.Trim().ToLowerInvariant();
                                var swatch = swatchMap.TryGetValue(key, out var css) ? css : key.Replace(" ", "");
                                <div class="tz-opt spec-filter" data-type="@ColorKey" data-value="@color"><span><i class="swatch" style="background:@swatch"></i>@color</span></div>
                            }
                        </div>
                    </div>
                }

                @foreach (var attrName in optionAttributeNames)
                {
                    <div class="tz-opt-group">
                        <span class="tz-opt-label">@attrName</span>
                        <div class="tz-opt-row">
                            @foreach (var value in attributeValues[attrName])
                            {
                                <div class="tz-opt spec-filter" data-type="@attrName" data-value="@value"><span>@value</span></div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="tz-config-buy">
                <div class="tz-stock">
                    <span>Availability: <strong id="txtStockStatus" class="text-success">In Stock</strong></span>
                </div>

                <div id="selectedVariantId" data-variant-id="@defaultVariant.ProductVariantId"></div>

                <div class="tz-buy">
                    <div class="tz-qty">
                        <button type="button" id="btnMinus" aria-label="Decrease quantity"><i class="bi bi-dash-lg"></i></button>
                        <input type="number" id="inputQuantity" value="1" min="1" autocomplete="off" aria-label="Quantity" />
                        <button type="button" id="btnPlus" aria-label="Increase quantity"><i class="bi bi-plus-lg"></i></button>
                    </div>
                    <button type="button" id="btnActionSubmit" class="tz-add" onclick="submitAddToCart()">
                        <i class="bi bi-cart-plus-fill me-2"></i> Add to cart
                    </button>
                </div>

                <div id="lblQuantityWarning" class="tz-warn d-none">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Not enough items available in stock.
                </div>

                <div class="tz-note"><i class="bi bi-shield-check"></i> Secure checkout after you review your cart</div>
            </div>
        </section>

        <!-- ============ AT A GLANCE ============ -->
        <section class="tz-glance">
            <h2 class="tz-section-title">At a glance</h2>
            <dl class="tz-tiles m-0">
                @foreach (var attrName in attributeNames)
                {
                    <div class="tz-tile"><div class="ico"><i class="bi @SpecIcon(attrName)"></i></div><dt>@attrName</dt><dd data-spec="@attrName">@defaultVariant.GetAttribute(attrName)</dd></div>
                }
                @if (uniqueColors.Any())
                {
                    <div class="tz-tile"><div class="ico"><i class="bi bi-palette"></i></div><dt>Color</dt><dd data-spec="@ColorKey">@defaultVariant.Color</dd></div>
                }
                <div class="tz-tile"><div class="ico"><i class="bi bi-patch-check"></i></div><dt>Brand</dt><dd>@Model.Brand</dd></div>
            </dl>
        </section>
    }
    else
    {
        <div class="tz-empty mt-4">
            <i class="bi bi-exclamation-triangle"></i>
            <p class="mb-0">No configuration options available for this product.</p>
        </div>
    }
}

<!-- ============ REVIEWS ============ -->
<section id="reviews" class="tz-reviews">
    <h2 class="tz-section-title">Customer reviews</h2>

    <div class="tz-rev-top">
        <div class="tz-score-card">
            <div class="tz-score-num">@avgRating.ToString("0.0", inv) <small>/ 5</small></div>
            <div class="mt-2"><span class="tz-stars lg" style="--rating:@avgRating.ToString("0.0", inv)"></span></div>
            <p>Based on @reviews.Count @(reviews.Count == 1 ? "review" : "reviews")</p>
        </div>

        <div class="tz-dist-card">
            @for (int star = 5; star >= 1; star--)
            {
                var count = reviews.Count(r => r.Rating == star);
                var percentage = reviews.Count > 0 ? (double)count / reviews.Count * 100 : 0;
                <div class="tz-dist-row">
                    <span class="lbl">@star <i class="bi bi-star-fill" style="color:#f59e0b;font-size:.75rem;"></i></span>
                    <div class="tz-dist-bar"><span style="width:@percentage.ToString("0.#", inv)%"></span></div>
                    <span class="cnt">@count</span>
                </div>
            }
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="tz-write">
            <h3>@(myReview == null ? "Write a review" : "Edit your review")</h3>
            @Html.AntiForgeryToken()
            <input type="hidden" id="reviewId" value="@(myReview?.Id ?? 0)" />
            <input type="hidden" id="reviewProductId" value="@Model!.ProductId" />

            <div class="mb-3">
                <label class="form-label fw-semibold d-block">Your rating <span class="text-danger">*</span></label>
                <div class="tz-star-picker" id="starPicker" role="radiogroup" aria-label="Your rating">
                    @for (int r = 1; r <= 5; r++)
                    {
                        <button type="button" class="@((myReview?.Rating ?? 0) >= r ? "on" : "")" data-value="@r" aria-label="@r star@(r == 1 ? "" : "s")"><i class="bi bi-star-fill"></i></button>
                    }
                </div>
                <span id="ratingText" class="tz-rating-text"></span>

                <select id="reviewRating" class="d-none" aria-hidden="true">
                    <option value="">-- Select Rating --</option>
                    @for (int r = 5; r >= 1; r--)
                    {
                        if (myReview?.Rating == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="reviewComment" class="form-label fw-semibold">Your review <span class="text-danger">*</span></label>
                <textarea id="reviewComment" class="form-control" rows="4" maxlength="1000"
                          placeholder="Share your experience with this product (at least 10 characters)">@myReview?.Comment</textarea>
                <div class="tz-counter"><span id="commentCount">0</span> / 1000</div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="button" id="btnSubmitReview" class="btn btn-primary px-4">
                    <i class="bi bi-send me-1"></i> @(myReview == null ? "Submit review" : "Update review")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="tz-login-note">
            <a href="@Url.Action("Login", "Auth")?returnUrl=@Url.Action("Index", "Product", new { id = Model?.ProductId })">Log in</a> to write a review.
        </div>
    }

    <div class="tz-rev-grid">
        @if (reviews.Count == 0)
        {
            <div class="tz-empty">
                <i class="bi bi-chat-square-text"></i>
                <p class="mb-0">No reviews yet. Be the first to review!</p>
            </div>
        }
        else
        {
            foreach (var review in reviews)
            {
                <article class="tz-review">
                    <div class="tz-review-head">
                        <div class="tz-avatar">@(string.IsNullOrEmpty(review.CustomerName) ? "?" : review.CustomerName.Substring(0, 1).ToUpper())</div>
                        <div>
                            <strong>@review.CustomerName</strong>
                            <time>@review.CreatedAt.ToString("MMM dd, yyyy", inv)</time>
                        </div>
                    </div>
                    <span class="tz-stars" style="--rating:@review.Rating"></span>
                    <p>@review.Comment</p>
                </article>
            }
        }
    </div>
</section>

@section Scripts {
    <script>
        // Variants coming from the server
        const variants = @Html.Raw(Json.Serialize(variantsForJs));

        // Stock of the currently selected variant
        let maxAvailableStock = @(defaultVariant?.StockQuantity ?? 0);

        // Selectable dimensions: "__color" plus every specification that differs between variants
        const dims = @Html.Raw(Json.Serialize(dimensionKeys));
        const COLOR_KEY = "__color";

        // Value of one dimension for a variant
        function getValue(v, type) {
            if (type === COLOR_KEY) return v.color || "";
            const found = (v.attrs || []).find(a => a.name === type);
            return found ? found.value : "";
        }

        // What the customer has picked so far (starts from the default variant)
        const defaultVariantId = @Html.Raw(Json.Serialize(defaultVariant?.ProductVariantId));
        const defaultJsVariant = variants.find(v => v.productVariantId === defaultVariantId) || variants[0];
        let currentSelection = {};
        if (defaultJsVariant) dims.forEach(d => { currentSelection[d] = getValue(defaultJsVariant, d); });

        const ADD_TO_CART_HTML = '<i class="bi bi-cart-plus-fill me-2"></i> Add to cart';
        const fmtVnd = new Intl.NumberFormat('vi-VN');

        document.addEventListener("DOMContentLoaded", function () {
            if (document.getElementById('btnActionSubmit')) {
                initClickEvents();
                initQuantityEvents();
                syncUI();
            }
            initReviewForm();
        });

        function initClickEvents() {
            document.querySelectorAll('.spec-filter').forEach(box => {
                box.addEventListener('click', function () {
                    const type = this.getAttribute('data-type');
                    const value = this.getAttribute('data-value');

                    // 1. remember what was just clicked
                    currentSelection[type] = value;

                    // 2. find the closest matching variant for the rest of the selection
                    let matchedVariants = variants.filter(v => getValue(v, type) === value);

                    if (matchedVariants.length > 0) {
                        let bestMatch = matchedVariants.find(v =>
                            dims.every(d => d === type || getValue(v, d) === (currentSelection[d] || ""))
                        ) || matchedVariants[0];

                        dims.forEach(d => { currentSelection[d] = getValue(bestMatch, d); });
                    }

                    // 3. refresh the UI
                    syncUI();
                });
            });
        }

        function initQuantityEvents() {
            const inputQty = document.getElementById('inputQuantity');
            const btnMinus = document.getElementById('btnMinus');
            const btnPlus = document.getElementById('btnPlus');

            btnMinus.addEventListener('click', function () {
                let currentVal = parseInt(inputQty.value) || 1;
                if (currentVal > 1) {
                    inputQty.value = currentVal - 1;
                    validateQuantity();
                }
            });

            btnPlus.addEventListener('click', function () {
                let currentVal = parseInt(inputQty.value) || 1;
                inputQty.value = currentVal + 1;
                validateQuantity();
            });

            inputQty.addEventListener('input', function () {
                let currentVal = parseInt(this.value);
                if (isNaN(currentVal) || currentVal < 1) {
                    this.value = 1;
                }
                validateQuantity();
            });
        }

        // Compare the requested quantity with the real stock
        function validateQuantity() {
            const inputQty = document.getElementById('inputQuantity');
            const btnSubmit = document.getElementById('btnActionSubmit');
            const warningEl = document.getElementById('lblQuantityWarning');

            let requestedQty = parseInt(inputQty.value) || 1;

            if (maxAvailableStock > 0) {
                if (requestedQty > maxAvailableStock) {
                    btnSubmit.disabled = true;
                    warningEl.classList.remove('d-none');
                } else {
                    btnSubmit.disabled = false;
                    warningEl.classList.add('d-none');
                }
            } else {
                warningEl.classList.add('d-none');
            }
        }

        function syncUI() {
            // STEP 1: option buttons (active + out-of-stock tag)
            document.querySelectorAll('.spec-filter').forEach(box => {
                const type = box.getAttribute('data-type');
                const value = box.getAttribute('data-value');

                const oldTag = box.querySelector('.variant-oos-tag');
                if (oldTag) oldTag.remove();
                box.classList.remove('is-oos');

                const relatedVariants = variants.filter(v => getValue(v, type) === value);
                const isEntirelyOOS = relatedVariants.length > 0 && relatedVariants.every(v => v.stockQuantity <= 0);

                if (isEntirelyOOS) {
                    box.classList.add('is-oos');
                    const oosTag = document.createElement('span');
                    oosTag.className = 'variant-oos-tag';
                    oosTag.innerText = 'Out of stock';
                    box.appendChild(oosTag);
                }

                if ((currentSelection[type] || "") === value) {
                    box.classList.add('active');
                } else {
                    box.classList.remove('active');
                }
            });

            // STEP 2: the exact variant for the current selection
            const exactMatch = variants.find(v =>
                dims.every(d => getValue(v, d) === (currentSelection[d] || ""))
            );

            // STEP 3: update the page
            const priceEl = document.getElementById('variantPriceText');
            const currencyEl = document.getElementById('variantCurrency');
            const oldPriceEl = document.getElementById('variantOldPriceText');
            const saveEl = document.getElementById('variantSaveText');
            const badgeEl = document.getElementById('variantDiscountBadge');
            const skuEl = document.getElementById('variantSkuText');
            const imgEl = document.getElementById('variantMainImage');
            const btnSubmit = document.getElementById('btnActionSubmit');
            const txtStockStatus = document.getElementById('txtStockStatus');
            const warningEl = document.getElementById('lblQuantityWarning');

            if (exactMatch) {
                document.getElementById('selectedVariantId').setAttribute('data-variant-id', exactMatch.productVariantId);

                const isOnSale = exactMatch.finalPrice < exactMatch.price;

                priceEl.innerText = fmtVnd.format(exactMatch.finalPrice);
                currencyEl.classList.remove('d-none');

                if (isOnSale) {
                    const pct = Math.round((1 - exactMatch.finalPrice / exactMatch.price) * 100);
                    oldPriceEl.innerText = fmtVnd.format(exactMatch.price) + ' ₫';
                    saveEl.innerText = 'Save ' + fmtVnd.format(exactMatch.price - exactMatch.finalPrice) + ' ₫';
                    badgeEl.innerText = '-' + pct + '%';
                    oldPriceEl.classList.remove('d-none');
                    saveEl.classList.remove('d-none');
                    badgeEl.classList.remove('d-none');
                } else {
                    oldPriceEl.classList.add('d-none');
                    saveEl.classList.add('d-none');
                    badgeEl.classList.add('d-none');
                }

                skuEl.innerText = exactMatch.sku;
                if (exactMatch.imageUrl) imgEl.src = exactMatch.imageUrl;

                // selected configuration sheet
                document.querySelectorAll('[data-spec]').forEach(el => {
                    el.innerText = getValue(exactMatch, el.getAttribute('data-spec')) || '—';
                });

                maxAvailableStock = exactMatch.stockQuantity;

                if (exactMatch.stockQuantity > 0) {
                    txtStockStatus.innerText = `In stock (${exactMatch.stockQuantity} available)`;
                    txtStockStatus.className = "text-success";
                    btnSubmit.innerHTML = ADD_TO_CART_HTML;
                    btnSubmit.disabled = false;
                    validateQuantity();
                } else {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = '<i class="bi bi-x-circle-fill me-2"></i> Out of stock';
                    txtStockStatus.innerText = "Out of stock";
                    txtStockStatus.className = "text-danger";
                    warningEl.classList.add('d-none');
                }
            } else {
                maxAvailableStock = 0;
                priceEl.innerText = "Unavailable";
                currencyEl.classList.add('d-none');
                oldPriceEl.classList.add('d-none');
                saveEl.classList.add('d-none');
                badgeEl.classList.add('d-none');
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<i class="bi bi-dash-circle-fill me-2"></i> Not available';
                txtStockStatus.innerText = "This combination is unavailable";
                txtStockStatus.className = "text-secondary";
                warningEl.classList.add('d-none');
            }
        }

        function submitAddToCart() {
            const variantId = document.getElementById('selectedVariantId').getAttribute('data-variant-id');
            const qty = parseInt(document.getElementById('inputQuantity').value) || 1;
            const btn = document.getElementById('btnActionSubmit');

            btn.disabled = true;

            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { variantId: variantId, quantity: qty },
                success: function (response) {
                    btn.disabled = false;
                    if (response.success) {
                        $("#cart-count").text(response.totalCount);
                        showToast(response.message, "success", "Cart Updated");
                    } else {
                        showToast(response.message, "error", "Add to Cart Failed");
                    }
                },
                error: function (xhr) {
                    btn.disabled = false;
                    if (xhr.status === 401 || xhr.status === 403) {
                        // Not signed in -> CartController is [Authorize]
                        window.location.href = '@Url.Action("Login", "Auth")?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        showToast("Error communicating with cart.", "error", "Connection Error");
                    }
                }
            });
        }

        // ---------- Review form ----------
        function initReviewForm() {
            const picker = document.getElementById('starPicker');
            const select = document.getElementById('reviewRating');
            const ratingText = document.getElementById('ratingText');
            const comment = document.getElementById('reviewComment');
            const counter = document.getElementById('commentCount');
            const labels = ['', 'Terrible', 'Poor', 'Average', 'Good', 'Excellent'];

            if (picker && select) {
                const stars = picker.querySelectorAll('button');
                const paint = (n, cls) => stars.forEach(s => s.classList.toggle(cls, parseInt(s.dataset.value) <= n));
                const setValue = (n) => {
                    select.value = n ? String(n) : '';
                    paint(n, 'on');
                    ratingText.innerText = n ? labels[n] : 'Select a rating';
                };

                stars.forEach(s => {
                    s.addEventListener('click', () => setValue(parseInt(s.dataset.value)));
                    s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.value), 'hover'));
                });
                picker.addEventListener('mouseleave', () => stars.forEach(s => s.classList.remove('hover')));

                setValue(parseInt(select.value) || 0);
            }

            if (comment && counter) {
                const update = () => counter.innerText = comment.value.length;
                comment.addEventListener('input', update);
                update();
            }
        }

        document.getElementById("btnSubmitReview")?.addEventListener("click", function () {
            const id = document.getElementById("reviewId").value;
            const isEdit = id && id !== "0";
            const url = isEdit ? '@Url.Action("Edit", "Reviews")' : '@Url.Action("Create", "Reviews")';
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const data = {
                __RequestVerificationToken: token,
                ProductId: document.getElementById("reviewProductId").value,
                Rating: document.getElementById("reviewRating").value,
                Comment: document.getElementById("reviewComment").value
            };
            if (isEdit) data.Id = id;

            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, "success", "Review");
                        setTimeout(() => location.reload(), 800);
                    } else {
                        showToast(res.message, "error", "Review Failed");
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) {
                        window.location.href = '@Url.Action("Login", "Auth")?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        showToast("Error submitting review.", "error", "Connection Error");
                    }
                }
            });
        });
    </script>
}
