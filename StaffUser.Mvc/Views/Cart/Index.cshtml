@model List<StaffUser.Mvc.Models.CartItem>
@{
    ViewData["Title"] = "My Cart";
}
@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<div class="row">
    <div class="col-12">
        <h2 class="fw-bold text-dark mb-4"><i class="bi bi-cart3 me-2 text-danger"></i>Shopping Cart</h2>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="text-center py-5 bg-white border rounded shadow-sm">
                <i class="bi bi-cart-x text-muted mb-3" style="font-size: 4rem; display: block;"></i>
                <h4 class="fw-bold text-dark">Your Cart is Empty</h4>
                <p class="text-muted">You haven't added any products to your cart yet.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-danger px-4 py-2 mt-2 text-white border-0" style="background-color: var(--color-primary); border-radius: 8px;">Shop Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-8">
            <div class="cart-card">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox" id="selectAllCheckbox" class="cart-item-checkbox" checked onchange="toggleSelectAll(this)" />
                        <label for="selectAllCheckbox" class="fw-semibold text-dark mb-0 cursor-pointer">Select All (@Model.Count items)</label>
                    </div>
                </div>

                <form id="checkoutForm" action="@Url.Action("Checkout", "Order")" method="post">
                    @Html.AntiForgeryToken()
                    @foreach (var item in Model)
                    {
                        var specsLabel = !string.IsNullOrEmpty(item.VariantSpecs) ? item.VariantSpecs : "Standard Model";
                        <div class="cart-item-row" id="row-@item.ProductVariantId">
                            <div class="pe-3">
                                <input type="checkbox" name="selectedVariantIds" value="@item.ProductVariantId" class="cart-item-checkbox item-select-check" checked data-price="@item.Price" data-qty="@item.Quantity" onchange="calculateSummary()" />
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <img src="/@(item.ImageUrl ?? "uploads/placeholder.png")" class="cart-item-img" alt="product thumbnail" />
                                <div class="flex-grow-1">
                                    <span class="product-brand" style="font-size: 0.72rem; font-weight: 600; text-transform: uppercase; color: #888888;">@item.Brand</span>
                                    <h6 class="fw-bold text-dark mb-1">@item.ProductName</h6>
                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.72rem; font-weight: 500;">
                                        @item.VariantColor / @specsLabel
                                    </span>
                                </div>
                            </div>
                            
                            <div class="text-end px-3">
                                <span class="fw-bold text-danger fs-5" id="price-@item.ProductVariantId">@((item.Price * item.Quantity).ToString("C"))</span>
                                <div class="text-muted small">@item.Price.ToString("C") each</div>
                            </div>

                            <div class="px-2">
                                <div class="qty-control">
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.ProductVariantId', -1)">-</button>
                                    <input type="number" class="qty-input" id="qty-@item.ProductVariantId" value="@item.Quantity" min="1" max="@item.MaxStock" onchange="updateQtyDirect('@item.ProductVariantId', this.value)" />
                                    <button type="button" class="qty-btn" onclick="adjustQty('@item.ProductVariantId', 1)">+</button>
                                </div>
                            </div>

                            <div class="ps-3">
                                <button type="button" class="remove-btn" onclick="removeCartItem('@item.ProductVariantId')" title="Remove item">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h5 class="fw-bold text-dark mb-4">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total items selected:</span>
                    <span class="fw-semibold text-dark" id="summary-items">0</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-bold text-danger fs-4" id="summary-total">$0.00</span>
                </div>

                <div class="alert alert-warning border-0 small mb-4 bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-info-circle-fill me-1"></i> Check out process requires login verification.
                </div>

                <button type="button" class="btn btn-danger w-100 py-2.5 fw-bold text-white border-0" style="background-color: var(--color-primary); border-radius: 8px;" onclick="submitCheckout()">
                    Transfer to Order <i class="bi bi-arrow-right-short fs-5 align-middle"></i>
                </button>
            </div>
        </div>
    }
</div>

<!-- Checkout Development Modal -->
<div class="modal fade" id="checkoutDevModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-info-circle text-primary" style="font-size: 3rem;"></i>
                <h5 class="fw-bold text-dark mt-3">Checkout & Order</h5>
                <p class="text-muted mt-2">The checkout process and order creation features are currently under development. These features will be integrated soon!</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal" style="border-radius: 8px;">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            calculateSummary();
        });

        function toggleSelectAll(master) {
            $(".item-select-check").prop("checked", master.checked);
            calculateSummary();
        }

        function calculateSummary() {
            let totalCount = 0;
            let totalAmount = 0;
            let allChecked = true;

            const checks = $(".item-select-check");
            if (checks.length === 0) {
                return;
            }

            checks.each(function() {
                if (this.checked) {
                    const price = parseFloat($(this).data("price"));
                    const qty = parseInt($(this).data("qty"));
                    totalCount += qty;
                    totalAmount += price * qty;
                } else {
                    allChecked = false;
                }
            });

            $("#selectAllCheckbox").prop("checked", allChecked && checks.length > 0);
            $("#summary-items").text(totalCount);
            
            // Format to currency (USD format matching default C# ToString("C"))
            const formatter = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
            });
            $("#summary-total").text(formatter.format(totalAmount));
        }

        function adjustQty(variantId, change) {
            const input = $("#qty-" + variantId);
            let current = parseInt(input.val()) || 1;
            let target = current + change;
            const max = parseInt(input.attr("max")) || 999;

            if (target < 1) target = 1;
            if (target > max) {
                showToast("Only " + max + " units are available in stock.", "info", "Stock Limit");
                target = max;
            }

            input.val(target);
            updateCartQuantityOnServer(variantId, target);
        }

        function updateQtyDirect(variantId, value) {
            let qty = parseInt(value) || 1;
            const input = $("#qty-" + variantId);
            const max = parseInt(input.attr("max")) || 999;

            if (qty < 1) qty = 1;
            if (qty > max) {
                showToast("Only " + max + " units are available in stock.", "info", "Stock Limit");
                qty = max;
            }

            input.val(qty);
            updateCartQuantityOnServer(variantId, qty);
        }

        function updateCartQuantityOnServer(variantId, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { variantId: variantId, quantity: quantity },
                success: function(response) {
                    if (response.success) {
                        // Update layout badge count
                        $("#cart-count").text(response.totalCount);
                        
                        // Update individual item row price label
                        const formatter = new Intl.NumberFormat('en-US', {
                            style: 'currency',
                            currency: 'USD',
                        });
                        $("#price-" + variantId).text(formatter.format(response.totalPrice));

                        // Update checkbox data attributes
                        const checkbox = $("input[value='" + variantId + "'].item-select-check");
                        checkbox.data("qty", quantity);

                        calculateSummary();
                    } else {
                        showToast(response.message, "error", "Update Failed");
                        setTimeout(() => window.location.reload(), 1500);
                    }
                },
                error: function() {
                    showToast("Error communicating with cart service.", "error", "Connection Error");
                }
            });
        }

        function removeCartItem(variantId) {
            if (!confirm("Are you sure you want to remove this item from the cart?")) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Remove", "Cart")',
                type: 'POST',
                data: { variantId: variantId },
                success: function(response) {
                    if (response.success) {
                        $("#row-" + variantId).fadeOut(400, function() {
                            $(this).remove();
                            $("#cart-count").text(response.totalCount);
                            
                            // If cart is empty, reload page to show empty cart banner
                            if (response.totalCount === 0) {
                                window.location.reload();
                            } else {
                                calculateSummary();
                            }
                        });
                    }
                },
                error: function() {
                    showToast("Error removing item.", "error", "Remove Failed");
                }
            });
        }

        function submitCheckout() {
            const ticked = $(".item-select-check:checked");
            if (ticked.length === 0) {
                showToast("Please select at least one item to proceed to order.", "info", "No Items Selected");
                return;
            }
            var myModal = new bootstrap.Modal(document.getElementById('checkoutDevModal'));
            myModal.show();
        }
    </script>
}
