@{
    ViewData["Title"] = "Log out";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="vx-auth-icon"><i class="bi bi-box-arrow-right"></i></div>

<div class="vx-auth-title">
    <h1>Log out of TimeZone?</h1>
    <p>You'll need to sign in again to view your orders and account.</p>
</div>

<form asp-action="Logout" asp-controller="Auth" method="post" class="d-grid gap-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Yes, log me out</button>
    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Stay signed in</a>
</form>
