@model BLL.DTOs.Customer.CustomerRegisterDto
@{
    ViewData["Title"] = "Create account";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="vx-auth-title">
    <h1>Create your account</h1>
    <p>Join TimeZone to shop mechanical watches, smartwatches and accessories.</p>
</div>

<form asp-action="Register" asp-controller="Auth" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="vx-flash err mb-3"></div>

    <div class="vx-field">
        <label for="FullName">Full name</label>
        <div class="vx-input">
            <i class="bi bi-person lead"></i>
            <input asp-for="FullName" class="form-control" id="FullName" placeholder="Your full name" autocomplete="name" />
        </div>
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="vx-field">
        <label for="Email">Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <input asp-for="Email" class="form-control" id="Email" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="vx-field">
        <label for="PhoneNumber">Phone number</label>
        <div class="vx-input">
            <i class="bi bi-telephone lead"></i>
            <input asp-for="PhoneNumber" class="form-control" id="PhoneNumber" placeholder="e.g. 0901 234 567" autocomplete="tel" />
        </div>
        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
    </div>

    <div class="vx-field">
        <label for="Password">Password</label>
        <div class="vx-input">
            <i class="bi bi-lock lead"></i>
            <input asp-for="Password" class="form-control" type="password" id="Password" placeholder="Create a password" autocomplete="new-password" />
            <button type="button" class="vx-pw-toggle" data-target="Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <div class="vx-strength" data-for="Password"><div class="bars"><span></span><span></span><span></span><span></span></div><small></small></div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create account</button>

    <p class="vx-auth-alt">Already have an account? <a asp-action="Login" asp-controller="Auth">Sign in</a></p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
