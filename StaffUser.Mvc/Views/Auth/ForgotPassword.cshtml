@{
    ViewData["Title"] = "Forgot password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<a asp-action="Login" asp-controller="Auth" class="vx-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>

<div class="vx-auth-title">
    <h1>Forgot your password?</h1>
    <p>Enter the email you registered with and we'll help you set a new one.</p>
</div>

<form asp-action="ForgotPassword" asp-controller="Auth" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="vx-flash err mb-3"></div>

    <div class="vx-field">
        <label for="email">Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Continue</button>
</form>
