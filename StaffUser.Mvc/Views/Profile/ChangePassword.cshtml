@model BLL.DTOs.Customer.CustomerChangePasswordDto
@{
    ViewData["Title"] = "Security";
    ViewData["ProfileTab"] = "security";
    Layout = "~/Views/Profile/_ProfileLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="vx-flash ok"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
}

<form asp-action="ChangePassword" method="post" class="vx-panel">
    @Html.AntiForgeryToken()
    <div class="vx-panel-head">
        <h2>Change password</h2>
        <p>Use a strong password that you don't use on other sites.</p>
    </div>

    <div class="vx-panel-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="vx-field">
            <label for="NewPassword">New password</label>
            <div class="vx-pw">
                <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" placeholder="At least 8 characters" />
                <button type="button" class="vx-pw-toggle" data-target="NewPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
            <div class="vx-help">At least 8 characters, with a letter, a number and a special character.</div>
        </div>

        <div class="vx-field">
            <label for="ConfirmPassword">Confirm new password</label>
            <div class="vx-pw">
                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" placeholder="Re-enter the new password" />
                <button type="button" class="vx-pw-toggle" data-target="ConfirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>

    <div class="vx-panel-foot">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to profile</a>
        <button type="submit" class="btn btn-primary px-4">Update password</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.vx-pw-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    </script>
}
