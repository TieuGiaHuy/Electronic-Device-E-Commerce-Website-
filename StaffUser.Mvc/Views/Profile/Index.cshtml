@model BLL.DTOs.Customer.CustomerProfileDto
@{
    ViewData["Title"] = "My Profile";
    ViewData["ProfileTab"] = "profile";
    Layout = "~/Views/Profile/_ProfileLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="vx-flash ok"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
}

<div class="vx-points">
    <small>TimeZone points</small>
    <strong>@Model.Points.ToString("N0")</strong>
    <span>Earned from your purchases</span>
    <i class="bi bi-stars"></i>
</div>

<form asp-action="Index" method="post" class="vx-panel">
    @Html.AntiForgeryToken()
    <div class="vx-panel-head">
        <h2>Personal information</h2>
        <p>Keep your contact details up to date so we can reach you about your orders.</p>
    </div>

    <div class="vx-panel-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6 vx-field">
                <label for="FullName">Full name</label>
                <input asp-for="FullName" class="form-control" placeholder="Your full name" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="col-md-6 vx-field">
                <label for="PhoneNumber">Phone number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 0901 234 567" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="col-12 vx-field">
                <label>Email address</label>
                <div class="vx-readonly">
                    <input class="form-control" value="@Model.Email" readonly />
                    <i class="bi bi-lock"></i>
                </div>
                <div class="vx-help">Your email is your sign-in and can't be changed here.</div>
            </div>
        </div>
    </div>

    <div class="vx-panel-foot">
        <span class="hint">Changes apply to your account immediately.</span>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
