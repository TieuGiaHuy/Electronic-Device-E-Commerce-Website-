@model BLL.DTOs.ProductReview.ProductReviewCreateDto
@{
    ViewData["Title"] = "Write a Review";
    var product = ViewBag.Product as BLL.DTOs.Product.ProductDto;
}

<!-- Custom Styles for Reviews Page -->
<link rel="stylesheet" href="~/css/reviews.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Products</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("ProductReviews", "Reviews", new { productId = product?.ProductId })">@product?.ProductName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Write Review</li>
                </ol>
            </nav>

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="fw-bold text-dark m-0">Write a Review</h1>
                    <p class="text-muted m-0">Share your experience with @product?.ProductName</p>
                </div>
                <a href="@Url.Action("ProductReviews", "Reviews", new { productId = product?.ProductId })" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Reviews
                </a>
            </div>

            <!-- Product Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(product?.ImageUrl))
                        {
                            var firstImage = product.ImageUrl.Split(';')[0];
                            <img src="/@firstImage" alt="@product.ProductName" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 80px; height: 80px;">
                                No Image
                            </div>
                        }
                        <div>
                            <h6 class="fw-bold text-dark mb-1">@product?.ProductName</h6>
                            <small class="text-muted">@product?.Brand</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review Form -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="ProductId" />

                        <!-- Rating -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold mb-2">Your Rating <span class="text-danger">*</span></label>
                            <select asp-for="Rating" class="form-select" style="max-width: 200px;">
                                <option value="">-- Select Rating --</option>
                                <option value="5">⭐⭐⭐⭐⭐ - Excellent (5)</option>
                                <option value="4">⭐⭐⭐⭐ - Good (4)</option>
                                <option value="3">⭐⭐⭐ - Average (3)</option>
                                <option value="2">⭐⭐ - Poor (2)</option>
                                <option value="1">⭐ - Terrible (1)</option>
                            </select>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <!-- Comment -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold mb-2" for="Comment">Your Review <span class="text-danger">*</span></label>
                            <textarea asp-for="Comment" class="form-control" rows="5" placeholder="Share your detailed experience with this product... (minimum 10 characters)"></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                            <div class="form-text">Minimum 10 characters, maximum 1000 characters.</div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a href="@Url.Action("ProductReviews", "Reviews", new { productId = product?.ProductId })" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4" style="background-color: #d70018; border-color: #d70018;">
                                <i class="bi bi-send me-1"></i> Submit Review
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>