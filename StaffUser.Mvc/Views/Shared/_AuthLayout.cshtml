<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TimeZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/techzone.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StaffUser.Mvc.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="vx-split">
        <aside class="vx-split-aside">
            <a class="vx-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
            </a>

            <div class="vx-aside-body">
                <span class="vx-aside-eyebrow"><i class="bi bi-stars"></i> Your watch store</span>
                <h2>Every moment, worn well.</h2>
                <p>Sign in to follow your orders, collect points and check out faster.</p>
                <ul class="vx-aside-list">
                    <li>
                        <span class="ico"><i class="bi bi-watch"></i></span>
                        <div><strong>Watches, smartwatches &amp; accessories</strong><span>Browse every timepiece in one place.</span></div>
                    </li>
                    <li>
                        <span class="ico"><i class="bi bi-truck"></i></span>
                        <div><strong>Track every order</strong><span>See the status of each purchase at a glance.</span></div>
                    </li>
                    <li>
                        <span class="ico"><i class="bi bi-gift"></i></span>
                        <div><strong>Earn points</strong><span>Get rewarded with points on your purchases.</span></div>
                    </li>
                </ul>
            </div>

            <div class="vx-aside-foot">&copy; @DateTime.Now.Year TimeZone. All rights reserved.</div>
        </aside>

        <main class="vx-split-main">
            <div class="vx-auth-box">
                <div class="vx-auth-mobile-brand">
                    <a class="vx-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
                    </a>
                </div>

                @RenderBody()

                <p class="vx-auth-foot">&copy; @DateTime.Now.Year TimeZone</p>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
