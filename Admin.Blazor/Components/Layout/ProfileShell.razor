@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

<div class="vx-prof">
    <header class="vx-prof-head">
        <div class="vx-prof-cover"></div>
        <div class="vx-prof-id">
            <div class="vx-avatar" aria-hidden="true">@Initials</div>
            <div class="vx-prof-who">
                <h1 class="vx-prof-name">@DisplayName</h1>
                @if (!string.IsNullOrEmpty(Email))
                {
                    <p class="vx-prof-email">@Email</p>
                }
            </div>
            <div class="vx-prof-chips">
                <span class="vx-chip"><i class="bi bi-shield-check"></i> Administrator</span>
                @if (IsActive.HasValue)
                {
                    <span class="vx-chip @(IsActive.Value ? "ok" : "off")"><i class="bi bi-circle-fill" style="font-size:.5rem;"></i> @(IsActive.Value ? "Active" : "Inactive")</span>
                }
            </div>
        </div>
    </header>

    <div class="vx-prof-layout">
        <nav class="vx-prof-nav" aria-label="Account">
            <span class="vx-prof-nav-label">Account</span>
            <a class="vx-prof-link @(Active == "profile" ? "active" : "")" href="/profile"><i class="bi bi-person"></i> Profile</a>
            <a class="vx-prof-link @(Active == "security" ? "active" : "")" href="/auth/change-password"><i class="bi bi-shield-lock"></i> Security</a>

            <span class="vx-prof-nav-label">Workspace</span>
            <a class="vx-prof-link" href=""><i class="bi bi-grid-1x2"></i> Dashboard</a>
            <a class="vx-prof-link" href="orders"><i class="bi bi-receipt"></i> Orders</a>

            <div class="vx-prof-sep"></div>
            <a class="vx-prof-link danger" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Log out</a>
        </nav>

        <div class="vx-prof-main">
            @ChildContent
        </div>
    </div>
</div>

@code {
    /// <summary>Name shown in the header. Falls back to the signed-in user's name.</summary>
    [Parameter] public string? Name { get; set; }
    /// <summary>"profile" or "security" – highlights the matching side-nav link.</summary>
    [Parameter] public string Active { get; set; } = "profile";
    [Parameter] public bool? IsActive { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ClaimsPrincipal? User => HttpContextAccessor.HttpContext?.User;
    private string? Email => User?.FindFirst(ClaimTypes.Email)?.Value;

    private string DisplayName =>
        !string.IsNullOrWhiteSpace(Name) ? Name!.Trim() : (User?.Identity?.Name ?? "Administrator");

    private string Initials
    {
        get
        {
            var seed = DisplayName.Contains('@') ? DisplayName.Split('@')[0] : DisplayName;
            var letters = seed.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries)
                              .Take(2).Select(w => char.ToUpperInvariant(w[0]));
            var result = string.Concat(letters);
            return string.IsNullOrEmpty(result) ? "A" : result;
        }
    }
}
