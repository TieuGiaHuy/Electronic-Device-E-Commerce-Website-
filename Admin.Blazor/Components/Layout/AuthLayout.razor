@inherits LayoutComponentBase

<div class="vx-split">
    <aside class="vx-split-aside">
        <span class="vx-brand">
            <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
            <span class="vx-brand-tag">Admin</span>
        </span>

        <div class="vx-aside-body">
            <span class="vx-aside-eyebrow"><i class="bi bi-shield-check"></i> Admin console</span>
            <h2>Run your whole store from one place.</h2>
            <p>Sign in to see how the store is performing and manage everything behind it.</p>
            <ul class="vx-aside-list">
                <li>
                    <span class="ico"><i class="bi bi-graph-up-arrow"></i></span>
                    <div><strong>Store overview</strong><span>Orders, revenue and reviews at a glance.</span></div>
                </li>
                <li>
                    <span class="ico"><i class="bi bi-box-seam"></i></span>
                    <div><strong>Catalog &amp; promotions</strong><span>Manage categories, products and discounts.</span></div>
                </li>
                <li>
                    <span class="ico"><i class="bi bi-people"></i></span>
                    <div><strong>Customers &amp; staff</strong><span>Control who can access what.</span></div>
                </li>
            </ul>
        </div>

        <div class="vx-aside-foot">&copy; @DateTime.Now.Year TimeZone. Administrators only.</div>
    </aside>

    <main class="vx-split-main">
        <div class="vx-auth-box">
            <div class="vx-auth-mobile-brand">
                <span class="vx-brand">
                    <span class="vx-brand-mark"><i class="bi bi-watch"></i></span> Time<span class="vx-brand-zone">Zone</span>
                    <span class="vx-brand-tag">Admin</span>
                </span>
            </div>

            @Body

            <p class="vx-auth-foot">&copy; @DateTime.Now.Year TimeZone</p>
        </div>
    </main>
</div>
