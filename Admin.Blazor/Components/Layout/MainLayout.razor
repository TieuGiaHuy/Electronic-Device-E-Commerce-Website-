@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center w-100">
            <div class="d-flex align-items-center">
                <h5 class="m-0 fw-bold text-secondary d-none d-sm-block me-3">Electronic Commerce Control Center</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle d-flex align-items-center gap-1 py-1.5 px-2.5 rounded-pill" style="font-size: 0.75rem; background-color: #e6fcf5 !important; border-color: #c3fae8 !important; color: #0ca678 !important; font-weight: 600;">
                    <span class="d-inline-block bg-success rounded-circle pulse-dot" style="width: 7px; height: 7px; background-color: #0ca678 !important; margin-right: 3px;"></span>
                    Admin Active
                </span>
            </div>
            <div class="d-flex align-items-center">
                <CascadingAuthenticationState>
                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex align-items-center gap-2">
                                <div class="text-end d-none d-md-block me-2">
                                    <div class="fw-bold text-white" style="font-size: 0.85rem; line-height: 1.1;">@context.User.Identity?.Name</div>
                                    <div class="text-white-50" style="font-size: 0.7rem;">@context.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                </div>
                                <a href="/auth/logout" class="btn btn-danger btn-sm">Logout</a>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/auth/login" class="btn btn-primary btn-sm">Login</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </CascadingAuthenticationState>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
