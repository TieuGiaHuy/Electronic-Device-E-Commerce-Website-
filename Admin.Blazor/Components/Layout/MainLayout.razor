@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-semibold text-dark d-none d-sm-inline" style="letter-spacing:-.01em;">Control center</span>
                <span class="badge rounded-pill d-inline-flex align-items-center gap-1 vx-live">
                    <span class="vx-live-dot pulse-dot"></span> Admin active
                </span>
            </div>

            <div class="vx-account">
                <CascadingAuthenticationState>
                    <AuthorizeView>
                        <Authorized>
                            <div class="vx-account-btn" tabindex="0" aria-label="Account">
                                <i class="bi bi-person"></i>
                            </div>
                            <ul class="vx-account-menu">
                                <li class="vx-account-hello">Hi, @context.User.Identity?.Name</li>
                                <li>
                                    <a class="vx-account-item" href="profile"><i class="bi bi-person-vcard"></i> Edit profile</a>
                                </li>
                                <li class="vx-account-divider"></li>
                                <li>
                                    <a class="vx-account-item vx-account-logout" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Log out</a>
                                </li>
                            </ul>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/auth/login" class="btn btn-primary btn-sm">Log in</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </CascadingAuthenticationState>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .vx-live { background: var(--vx-success-soft) !important; color: #15803d !important; font-size: .72rem; font-weight: 600; padding: .35rem .65rem; }
    .vx-live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--vx-success); display: inline-block; }
    @@keyframes pulse { 0%,100% { transform: scale(.9); opacity: 1; } 50% { transform: scale(1.25); opacity: .6; } }
    .pulse-dot { animation: pulse 2s infinite; }

    .vx-account { position: relative; padding: .4rem 0; }
    .vx-account-btn { width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center; background: var(--vx-accent-soft); color: var(--vx-accent); font-size: 1.15rem; cursor: pointer; transition: background .15s; }
    .vx-account:hover .vx-account-btn, .vx-account-btn:focus { background: #e0e7ff; }
    .vx-account-menu { position: absolute; right: 0; top: 100%; min-width: 200px; margin: 0; padding: .4rem; list-style: none; background: var(--vx-surface); border: 1px solid var(--vx-line); border-radius: var(--vx-radius); box-shadow: var(--vx-shadow-lg); opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility .15s; z-index: 50; }
    .vx-account:hover .vx-account-menu, .vx-account:focus-within .vx-account-menu { opacity: 1; visibility: visible; transform: none; }
    .vx-account-hello { padding: .5rem .75rem; margin-bottom: .25rem; font-size: .82rem; font-weight: 600; color: var(--vx-ink); background: var(--vx-line-soft); border-radius: var(--vx-radius-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .vx-account-item { display: flex; align-items: center; gap: .6rem; padding: .5rem .75rem; border-radius: var(--vx-radius-sm); font-size: .88rem; color: var(--vx-text) !important; text-decoration: none !important; }
    .vx-account-item i { color: var(--vx-muted); }
    .vx-account-item:hover { background: var(--vx-line-soft); color: var(--vx-ink) !important; }
    .vx-account-logout, .vx-account-logout i { color: var(--vx-danger) !important; }
    .vx-account-logout:hover { background: var(--vx-danger-soft); }
    .vx-account-divider { height: 1px; margin: .35rem 0; background: var(--vx-line-soft); }
</style>
