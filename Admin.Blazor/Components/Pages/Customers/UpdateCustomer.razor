@page "/customers/update"
@using BLL.DTOs.Customer
@using BLL.Services.Interfaces
@using DAL.Enums
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject NavigationManager NavigationManager

<div class="modal-header">
    <h5 class="modal-title fw-bold">Update Staff</h5>

    <button type="button"
            class="btn-close"
            @onclick="OnCancel">
    </button>
</div>

<div class="modal-body">

    <div class="row g-3">

        <!-- Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Full Name
            </label>

            <input class="form-control"
                   placeholder="Enter full name..." @bind="staffUpdateDto.FullName" />
        </div>

        <!-- mail -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Email
            </label>

            <input class="form-control"
                   placeholder="Enter email..." @bind="staffUpdateDto.Email" />
        </div>

        <!-- phone -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Phone
            </label>

            <input class="form-control"
                   placeholder="Enter phone..." @bind="staffUpdateDto.PhoneNumber" />
        </div>

        <!--Role-->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Staff Role
            </label>
            <select class=" form-control" @bind="staffUpdateDto.Role">
                @foreach (var role in Enum.GetValues<RoleEnum>())
                {
                    <option selected="@IsRoleSelected(staffUpdateDto.Role, role)" value="@role">@role</option>
                }
            </select>
        </div>

        <!--isactive-->
        <div class="col-md-6">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" @bind="staffUpdateDto.IsActive" id="isActiveCheck" />
                <label class="form-check-label fw-semibold" for="isActiveCheck">
                    Staff Is Active
                </label>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-12" style="color: red;">@errorMessage</div>
        </div>
    </div>
</div>

<div class="modal-footer">

    <button class="btn btn-secondary"
            @onclick="OnCancel">
        Cancel
    </button>

    <button class="btn btn-danger" @onclick="Update">
        Update Promotion
    </button>

</div>

@code {
    [Parameter]
    public EventCallback OnEdited { get; set; }
    [Parameter]
    public EventCallback OnCancel { get; set; }
    private string errorMessage = string.Empty;

    [Parameter] public CustomerDto staffDto { get; set; } = new CustomerDto();
    private CustomerUpdateDto staffUpdateDto = new CustomerUpdateDto();

    protected override void OnParametersSet()
    {
        if (staffDto != null)
        {
            staffUpdateDto = new CustomerUpdateDto
            {
                FullName = staffDto.FullName,
                Email = staffDto.Email,
                PhoneNumber = staffDto.PhoneNumber,
                Role = staffDto.Role,
                Points = staffDto.Points,
                IsActive = staffDto.IsActive
            };
        }
    }

    private async Task Update()
    {
        try
        {
            await CustomerService.UpdateCustomerAsync(staffDto.CustomerId, staffUpdateDto);
            await OnEdited.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private bool IsRoleSelected(RoleEnum staff, RoleEnum role)
    {
        if (staff == role)
        {
            return true;
        }
        return false;
    }
}