@page "/customers/create"
@using BLL.DTOs.Customer
@using BLL.Services.Interfaces
@using DAL.Enums
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject NavigationManager NavigationManager

<div class="modal-header">
    <h5 class="modal-title fw-bold">Create Staff</h5>

    <button type="button"
            class="btn-close"
            @onclick="OnCancel">
    </button>
</div>

<div class="modal-body">

    <div class="row g-3">

        <!-- Name -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Full Name
            </label>

            <input class="form-control"
                   placeholder="Enter full name..." @bind="staffCreateDto.FullName" />
        </div>

        <!-- mail -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Email
            </label>

            <input class="form-control"
                   placeholder="Enter email..." @bind="staffCreateDto.Email" />
        </div>

        <!-- phone -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Phone
            </label>

            <input class="form-control"
                   placeholder="Enter phone..." @bind="staffCreateDto.PhoneNumber" />
        </div>

        <!--Pass-->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Password
            </label>

            <input class="form-control" placeholder="Enter password..." @bind="staffCreateDto.Password"/>
        </div>

        <!--Role-->
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Staff Role
            </label>
            <select class=" form-control" @bind="staffCreateDto.Role">
                @foreach (var role in Enum.GetValues<RoleEnum>())
                {
                    <option selected="@IsRoleSelected(staffCreateDto.Role, role)" value="@role">@role</option>
                }
            </select>
        </div>

        <!--isactive-->
        <div class="col-md-6">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" @bind="staffCreateDto.IsActive" id="isActiveCheck" />
                <label class="form-check-label fw-semibold" for="isActiveCheck">
                    Staff Is Active
                </label>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-12" style="color: red;">@errorMessage</div>
        </div>
    </div>
</div>

<div class="modal-footer">

    <button class="btn btn-secondary"
            @onclick="OnCancel">
        Cancel
    </button>

    <button class="btn btn-danger" @onclick="Create">
        Create Staff
    </button>

</div>

@code {
    [Parameter]
    public EventCallback OnCreated { get; set; }
    [Parameter]
    public EventCallback OnCancel { get; set; }
    private string errorMessage = string.Empty;

    private CustomerCreateDto staffCreateDto = new CustomerCreateDto();

    private async Task Create()
    {
        try
        {
            await CustomerService.CreateAsync(staffCreateDto);
            await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private bool IsRoleSelected(RoleEnum staff, RoleEnum role)
    {
        if (staff == role)
        {
            return true;
        }
        return false;
    }
}