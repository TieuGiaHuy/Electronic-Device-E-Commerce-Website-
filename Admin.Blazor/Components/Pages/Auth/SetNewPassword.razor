@page "/auth/set-new-password"
@layout AuthLayout
@using Admin.Blazor.Components.Layout
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Set new password - TimeZone Admin</PageTitle>

<a href="/auth/login" class="vx-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>

<div class="vx-auth-title">
    <h1>Set a new password</h1>
    <p>Choose a strong password for your admin account.</p>
</div>

<EditForm Model="Input" OnValidSubmit="HandleSetPassword" FormName="SetNewPasswordForm">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="vx-flash err mb-3"><i class="bi bi-exclamation-circle-fill"></i> @ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="vx-flash ok mb-3"><i class="bi bi-check-circle-fill"></i> @SuccessMessage</div>
    }

    <div class="vx-field">
        <label>New password</label>
        <div class="vx-input">
            <i class="bi bi-lock lead"></i>
            <InputText @bind-Value="Input.Password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" />
            <button type="button" class="vx-pw-toggle" aria-label="Show password" @onclick="() => showPassword = !showPassword"><i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i></button>
        </div>
        <div class="small"><ValidationMessage For="() => Input.Password" class="text-danger" /></div>
    </div>

    <div class="vx-field">
        <label>Confirm password</label>
        <div class="vx-input">
            <i class="bi bi-lock-fill lead"></i>
            <InputText @bind-Value="Input.ConfirmPassword" type="@(showConfirm ? "text" : "password")" class="form-control" placeholder="Re-enter the new password" autocomplete="new-password" />
            <button type="button" class="vx-pw-toggle" aria-label="Show password" @onclick="() => showConfirm = !showConfirm"><i class="bi @(showConfirm ? "bi-eye-slash" : "bi-eye")"></i></button>
        </div>
        <div class="small"><ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" /></div>
    </div>

    <button type="submit" class="btn btn-primary mt-2 d-inline-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        Update password
    </button>
</EditForm>

@code {
    private bool showPassword;
    private bool showConfirm;

    [SupplyParameterFromQuery]
    private string Email { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    private SetNewPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleSetPassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        // Basic request validation: email must be present (passed from forgot-password)
        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Invalid request. Please start from the forgot password page.";
            isLoading = false;
            return;
        }

        // Lookup staff and set hashed password via BLL service
        var staff = await StaffService.GetByEmailAsync(Email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        // SetPasswordAsync will hash the password and update the repository
        await StaffService.SetPasswordAsync(staff.StaffId, Input.Password);
        SuccessMessage = "Password updated successfully.";
        isLoading = false;

        // Redirect to login after a short delay
        await Task.Delay(1500);
        Navigation.NavigateTo("/auth/login");
    }

    public class SetNewPasswordInput
    {
        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        [RegularExpression(@"^(?=.*[a-zA-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':""\\|,.<>\/?]).+$",
            ErrorMessage = "Password must contain at least one letter, one number, and one special character.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
