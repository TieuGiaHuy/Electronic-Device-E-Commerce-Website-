@page "/auth/set-new-password"
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@inject IStaffService StaffService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Set New Password</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="Input" OnValidSubmit="HandleSetPassword" FormName="SetNewPasswordForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText @bind-Value="Input.Password" type="password" class="form-control" />
                            <ValidationMessage For="() => Input.Password" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control" />
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <div class="alert alert-success">@SuccessMessage</div>
                        }

                        <button type="submit" class="btn btn-info w-100" disabled="@isLoading">
                            @if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Set Password
                        </button>
                    </EditForm>
                </div>
                <div class="card-footer text-center">
                    <a href="/auth/login" class="text-decoration-none">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Email { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    private SetNewPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleSetPassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        // Basic request validation: email must be present (passed from forgot-password)
        if (string.IsNullOrWhiteSpace(Email))
        {
            ErrorMessage = "Invalid request. Please start from the forgot password page.";
            isLoading = false;
            return;
        }

        // Lookup staff and set hashed password via BLL service
        var staff = await StaffService.GetByEmailAsync(Email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        // SetPasswordAsync will hash the password and update the repository
        await StaffService.SetPasswordAsync(staff.StaffId, Input.Password);
        SuccessMessage = "Password updated successfully.";
        isLoading = false;

        // Redirect to login after a short delay
        await Task.Delay(1500);
        Navigation.NavigateTo("/auth/login");
    }

    public class SetNewPasswordInput
    {
        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        [RegularExpression(@"^(?=.*[a-zA-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':""\\|,.<>\/?]).+$", 
            ErrorMessage = "Password must contain at least one letter, one number, and one special character.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}