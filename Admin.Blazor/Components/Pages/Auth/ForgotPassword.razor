@page "/auth/forgot-password"
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<div class="login-wrapper d-flex flex-column align-items-center justify-content-center min-vh-100 p-3">
    <div class="text-center mb-4 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-star-fill text-danger fs-4"></i>
        <h2 class="fw-bold mb-0 text-dark header-title">ECommerce <span class="badge bg-danger fs-6 align-middle px-2 py-0.5 rounded-pill">ADMIN</span></h2>
    </div>

    <div class="card border-0 shadow-lg p-4 p-sm-5 text-center custom-card">

        <h3 class="fw-bold text-dark mb-1">Forgot Password</h3>
        <p class="text-muted small mb-4">Enter your email to reset your admin dashboard password</p>

        <EditForm Model="Input" OnValidSubmit="HandleForgotPassword" FormName="ForgotPasswordForm" class="text-start">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="form-label fw-semibold text-dark small mb-2">Email Address</label>
                <div class="input-group custom-input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                    <InputText @bind-Value="Input.Email" class="form-control bg-light border-start-0 ps-1" placeholder="Enter your email address" />
                </div>
                <div class="mt-1 small">
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger custom-alert border-0 d-flex align-items-center gap-2 mb-4 small" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <div>@ErrorMessage</div>
                </div>
            }

            <button type="submit" class="btn btn-danger w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm custom-btn-danger mb-3" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Reset Password</span>
                }
            </button>

            <div class="text-center mt-3">
                <a href="/auth/login" class="back-to-login-link small fw-semibold text-decoration-none d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>
        </EditForm>
    </div>
</div>

<style>
    /* Nền phủ kín toàn bộ màn hình độc lập không phụ thuộc layout */
    .login-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        background: radial-gradient(circle, rgba(244,245,247,1) 0%, rgba(230,233,238,1) 100%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow-y: auto;
    }

    .header-title {
        letter-spacing: -0.5px;
    }

    /* Khung chứa Card trắng đồng bộ với trang Login */
    .custom-card {
        width: 100%;
        max-width: 460px;
        border-radius: 12px !important;
        background-color: #ffffff;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important;
    }

    /* Input xám nhạt tinh tế tích hợp icon Bootstrap */
    .custom-input-group .input-group-text,
    .custom-input-group .form-control {
        background-color: #f8f9fa !important;
        border-color: #e9ecef !important;
        padding-top: 0.7rem;
        padding-bottom: 0.7rem;
        font-size: 0.95rem;
        color: #495057 !important;
    }

        .custom-input-group .form-control::placeholder {
            color: #adb5bd;
        }

        .custom-input-group .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6 !important;
        }

    /* Nút kích hoạt màu đỏ thương hiệu */
    .custom-btn-danger {
        background-color: #d90429 !important;
        border: none;
        border-radius: 6px;
        font-size: 0.95rem;
        transition: background-color 0.2s ease;
    }

        .custom-btn-danger:hover {
            background-color: #b30322 !important;
        }

    /* Custom liên kết "Back to Login" */
    .back-to-login-link {
        color: #d90429;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .back-to-login-link:hover {
            color: #b30322;
            text-decoration: underline !important;
        }

    /* Custom giao diện thông báo lỗi hệ thống */
    .custom-alert {
        background-color: #fff5f5;
        color: #e53e3e;
        border-radius: 6px;
    }
</style>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        ErrorMessage = null;

        var staff = await StaffService.GetByEmailAsync(Input.Email);
        if (staff == null)
        {
            ErrorMessage = "Email address not found.";
            isLoading = false;
            return;
        }

        Navigation.NavigateTo($"/auth/set-new-password?email={Input.Email}");
    }

    public class ForgotPasswordInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;
    }
}