@page "/auth/forgot-password"
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@inject IStaffService StaffService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Forgot Password</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="Input" OnValidSubmit="HandleForgotPassword" FormName="ForgotPasswordForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="Input.Email" class="form-control" />
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        <button type="submit" class="btn btn-info w-100" disabled="@isLoading">
                            @if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Reset Password
                        </button>
                    </EditForm>
                </div>
                <div class="card-footer text-center">
                    <a href="/auth/login" class="text-decoration-none">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        ErrorMessage = null;

        var staff = await StaffService.GetByEmailAsync(Input.Email);
        if (staff == null)
        {
            ErrorMessage = "Email address not found.";
            isLoading = false;
            return;
        }

        Navigation.NavigateTo($"/auth/set-new-password?email={Input.Email}");
    }

    public class ForgotPasswordInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;
    }
}