@page "/auth/forgot-password"
@layout AuthLayout
@using Admin.Blazor.Components.Layout
@using BLL.Services.Interfaces
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Forgot password - TimeZone Admin</PageTitle>

<a href="/auth/login" class="vx-back"><i class="bi bi-arrow-left"></i> Back to sign in</a>

<div class="vx-auth-title">
    <h1>Forgot your password?</h1>
    <p>Enter your admin email and we'll help you set a new password.</p>
</div>

<EditForm Model="Input" OnValidSubmit="HandleForgotPassword" FormName="ForgotPasswordForm">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="vx-flash err mb-3"><i class="bi bi-exclamation-circle-fill"></i> @ErrorMessage</div>
    }

    <div class="vx-field">
        <label>Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <InputText @bind-Value="Input.Email" class="form-control" placeholder="admin@company.com" autocomplete="email" />
        </div>
        <div class="small"><ValidationMessage For="() => Input.Email" class="text-danger" /></div>
    </div>

    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
        Continue
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        ErrorMessage = null;

        var staff = await StaffService.GetByEmailAsync(Input.Email);
        if (staff == null)
        {
            ErrorMessage = "Email address not found.";
            isLoading = false;
            return;
        }

        Navigation.NavigateTo($"/auth/set-new-password?email={Input.Email}");
    }

    public class ForgotPasswordInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;
    }
}
