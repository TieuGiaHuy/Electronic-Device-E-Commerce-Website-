@page "/auth/login"
@inject NavigationManager Navigation

<div class="login-wrapper d-flex flex-column align-items-center justify-content-center min-vh-100 p-3">
    <div class="text-center mb-4 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-star-fill text-danger fs-4"></i>
        <h2 class="fw-bold mb-0 text-dark header-title">ECommerce <span class="badge bg-danger fs-6 align-middle px-2 py-0.5 rounded-pill">ADMIN</span></h2>
    </div>

    <div class="card border-0 shadow-lg p-4 p-sm-5 text-center custom-card">

        <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
        <p class="text-muted small mb-4">Sign in to access your admin dashboard</p>

        <form method="post" action="/auth/login-api" class="text-start">
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark small mb-2">Email Address</label>
                <div class="input-group custom-input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                    <input name="email" type="email" class="form-control bg-light border-start-0 ps-1" placeholder="Enter your email address" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-dark small mb-2">Password</label>
                <div class="input-group custom-input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input name="password" type="password" class="form-control bg-light border-start-0 border-end-0 ps-1" placeholder="Enter your password" required />
                    <span class="input-group-text bg-light border-start-0 text-muted cursor-pointer"><i class="bi bi-eye-slash"></i></span>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check d-flex align-items-center gap-2 ps-0 m-0">
                    <input type="checkbox" class="form-check-input custom-checkbox m-0" id="rememberMe">
                    <label class="form-check-label text-muted small cursor-pointer select-none" for="rememberMe">Remember me</label>
                </div>
                <a @onclick='() => Navigation.NavigateTo("/auth/forgot-password")' class="forgot-password-link small fw-semibold text-decoration-none">Forgot Password?</a>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm custom-btn-danger">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
        </form>
    </div>
</div>

<style>
    /* Nền phủ kín toàn bộ chiều rộng và chiều cao màn hình trình duyệt */
    .login-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        background: radial-gradient(circle, rgba(244,245,247,1) 0%, rgba(230,233,238,1) 100%);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow-y: auto;
    }

    .header-title {
        letter-spacing: -0.5px;
    }

    /* Định dạng Card trắng tinh tế */
    .custom-card {
        width: 100%;
        max-width: 460px;
        border-radius: 12px !important;
        background-color: #ffffff;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important;
    }

    /* Thiết lập ô Input màu xám nhạt nhẹ giống hình */
    .custom-input-group .input-group-text,
    .custom-input-group .form-control {
        background-color: #f8f9fa !important;
        border-color: #e9ecef !important;
        padding-top: 0.7rem;
        padding-bottom: 0.7rem;
        font-size: 0.95rem;
        color: #495057 !important;
    }

        .custom-input-group .form-control::placeholder {
            color: #adb5bd;
        }

        .custom-input-group .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6 !important;
        }

    /* Tinh chỉnh Custom Checkbox */
    .custom-checkbox {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border: 1px solid #ced4da;
        cursor: pointer;
    }

        .custom-checkbox:checked {
            background-color: #d90429;
            border-color: #d90429;
        }

    /* Đường dẫn quên mật khẩu */
    .forgot-password-link {
        color: #d90429;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .forgot-password-link:hover {
            color: #b30322;
            text-decoration: underline !important;
        }

    /* Nút đăng nhập */
    .custom-btn-danger {
        background-color: #d90429 !important;
        border: none;
        border-radius: 6px;
        font-size: 0.95rem;
        transition: background-color 0.2s ease;
    }

        .custom-btn-danger:hover {
            background-color: #b30322 !important;
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .select-none {
        user-select: none;
    }
</style>