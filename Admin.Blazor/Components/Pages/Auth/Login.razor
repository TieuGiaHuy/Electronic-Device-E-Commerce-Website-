@page "/auth/login"
@layout AuthLayout
@using Admin.Blazor.Components.Layout
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

@attribute [AllowAnonymous]

<PageTitle>Sign in - TimeZone Admin</PageTitle>

<div class="vx-auth-title">
    <h1>Welcome back</h1>
    <p>Sign in to access your admin dashboard.</p>
</div>

<form method="post" action="/auth/login-api">
    <div class="vx-field">
        <label for="loginEmail">Email</label>
        <div class="vx-input">
            <i class="bi bi-envelope lead"></i>
            <input id="loginEmail" name="email" type="email" class="form-control" placeholder="admin@company.com" autocomplete="email" required />
        </div>
    </div>

    <div class="vx-field">
        <label for="loginPassword">Password</label>
        <div class="vx-input">
            <i class="bi bi-lock lead"></i>
            <input id="loginPassword" name="password" type="@(showPassword ? "text" : "password")" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
            <button type="button" class="vx-pw-toggle" aria-label="Show password" @onclick="() => showPassword = !showPassword"><i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i></button>
        </div>
    </div>

    <div class="vx-auth-row">
        <label class="vx-check" for="rememberMe">
            <input type="checkbox" id="rememberMe" /> Remember me
        </label>
        <a href="/auth/forgot-password" class="auth-link">Forgot password?</a>
    </div>

    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-box-arrow-in-right"></i> Sign in
    </button>
</form>

@code {
    private bool showPassword;
}
