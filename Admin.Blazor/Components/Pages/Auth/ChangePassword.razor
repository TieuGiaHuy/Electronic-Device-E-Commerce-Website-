@page "/auth/change-password"
@using Admin.Blazor.Components.Layout
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

@attribute [Authorize(Roles = "Admin")]

<PageTitle>Security - TimeZone Admin</PageTitle>

<ProfileShell Active="security">
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="vx-flash ok"><i class="bi bi-check-circle-fill"></i> @SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="vx-flash err"><i class="bi bi-exclamation-circle-fill"></i> @ErrorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="HandleChangePassword" FormName="ChangePasswordForm" class="vx-panel">
        <DataAnnotationsValidator />

        <div class="vx-panel-head">
            <h2>Change password</h2>
            <p>Use a strong password that you don't use on other sites.</p>
        </div>

        <div class="vx-panel-body">
            <div class="vx-field">
                <label>New password</label>
                <div class="vx-pw">
                    <InputText @bind-Value="Input.NewPassword" type="@(showNew ? "text" : "password")" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" />
                    <button type="button" class="vx-pw-toggle" aria-label="Show password" @onclick="() => showNew = !showNew"><i class="bi @(showNew ? "bi-eye-slash" : "bi-eye")"></i></button>
                </div>
                <div class="small"><ValidationMessage For="() => Input.NewPassword" class="text-danger" /></div>
                <div class="vx-help">At least 8 characters, with a letter, a number and a special character.</div>
            </div>

            <div class="vx-field">
                <label>Confirm new password</label>
                <div class="vx-pw">
                    <InputText @bind-Value="Input.ConfirmPassword" type="@(showConfirm ? "text" : "password")" class="form-control" placeholder="Re-enter the new password" autocomplete="new-password" />
                    <button type="button" class="vx-pw-toggle" aria-label="Show password" @onclick="() => showConfirm = !showConfirm"><i class="bi @(showConfirm ? "bi-eye-slash" : "bi-eye")"></i></button>
                </div>
                <div class="small"><ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" /></div>
            </div>
        </div>

        <div class="vx-panel-foot">
            <a href="/profile" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to profile</a>
            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                Update password
            </button>
        </div>
    </EditForm>
</ProfileShell>

@code {
    private bool showNew;
    private bool showConfirm;

    [SupplyParameterFromForm]
    private StaffChangePasswordDto Input { get; set; } = new();

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleChangePassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var httpContext = HttpContextAccessor.HttpContext;
        var email = httpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var staff = await StaffService.GetByEmailAsync(email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        await StaffService.SetPasswordAsync(staff.StaffId, Input.NewPassword);
        SuccessMessage = "Password changed successfully.";
        isLoading = false;

        await Task.Delay(1500);
        Navigation.NavigateTo("/profile");
    }
}
