@page "/auth/change-password"
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using System.Security.Claims
@inject IStaffService StaffService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Change Password</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="Input" OnValidSubmit="HandleChangePassword" FormName="ChangePasswordForm">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText @bind-Value="Input.NewPassword" type="password" class="form-control" />
                            <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control" />
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <div class="alert alert-success">@SuccessMessage</div>
                        }

                        <button type="submit" class="btn btn-warning w-100" disabled="@isLoading">
                            @if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Change Password
                        </button>
                    </EditForm>
                </div>
                <div class="card-footer text-center">
                    <a href="/profile" class="text-decoration-none">Back to Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private StaffChangePasswordDto Input { get; set; } = new();

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }

    private async Task HandleChangePassword()
    {
        isLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        var httpContext = HttpContextAccessor.HttpContext;
        var email = httpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var staff = await StaffService.GetByEmailAsync(email);
        if (staff == null)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        await StaffService.SetPasswordAsync(staff.StaffId, Input.NewPassword);
        SuccessMessage = "Password changed successfully.";
        isLoading = false;

        await Task.Delay(1500);
        Navigation.NavigateTo("/profile");
    }
}