@page "/staff_management"
@using AutoMapper
@using BLL.DTOs.Pagination
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using DAL.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@rendermode InteractiveServer
@inject IStaffService StaffService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>AdminStaffs - StaffManager</PageTitle>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="fw-bold mb-1">Staff</h1>
        </div>

        <button class="btn btn-danger px-4 py-2" @onclick="showCreate">
            <i class="bi bi-plus-lg"></i>
            Create Staff
        </button>
    </div>

    <!-- Statistics -->
    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="card rounded-4 h-100">
                <div class="card-body py-4">
                    <p class="text-uppercase text-secondary fw-semibold small mb-2">
                        Total Staffs
                    </p>
                    <h1 class="fw-bold mb-0">@staffs?.Pagination.TotalCount</h1>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card rounded-4 h-100">
                <div class="card-body py-4">
                    <p class="text-uppercase text-success fw-semibold small mb-2">
                        Active
                    </p>
                    <h1 class="fw-bold text-success mb-0">@staffs?.ActiveCount</h1>
                </div>
            </div>
        </div>

      @*   <div class="col-lg-3 col-md-6">
            <div class="card rounded-4 h-100">
                <div class="card-body py-4">
                    <p class="text-uppercase text-warning fw-semibold small mb-2">
                        Upcoming
                    </p>
                    <h1 class="fw-bold text-warning mb-0">@promotions?.Upcoming</h1>
                </div>
            </div>
        </div> *@

        @* <div class="col-lg-3 col-md-6">
            <div class="card rounded-4 h-100">
                <div class="card-body py-4">
                    <p class="text-uppercase text-danger fw-semibold small mb-2">
                        Expired
                    </p>
                    <h1 class="text-uppercase text-danger fw-semibold small mb-2">@promotions?.ExpiredOrDisabledCount</h1>
                </div>
            </div>
        </div> *@
    </div>

    <!-- Filter -->
    <div class="mt-4">
        <div class="card rounded-4 shadow-sm">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <!-- Search -->
                    <div class="col-lg-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control border-start-0 bg-light"
                                   placeholder="Search staff name..." @bind="searchName" @bind:event="oninput" @onkeyup="LoadStaffs">
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="col-lg-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   value="01/01/2024 - 31/12/2024"
                                   readonly>
                        </div>
                    </div>

                    <!-- Filter Button -->
                    <div class="col-lg-2">
                        <button class="btn btn-light border w-100">
                            <i class="bi bi-funnel me-2"></i>
                            Filter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Staffs List -->
    <div class="card rounded-4 shadow-sm mt-4">
        @if (staffs == null)
        {
            <div class="card-body text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (staffs.Pagination.Items.Count == 0)
        {
            <div class="card-body text-center">
                <p class="text-secondary mb-0">No staffs found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Index</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int index = staffs.Pagination.StartIndex;
                        }
                        @foreach (var staff in staffs.Pagination.Items)
                        {
                            <tr>
                                <td>@index</td>
                                <td>@staff.FullName</td>
                                <td>@staff.Email</td>
                                <td>@staff.Role</td>
                                <td>
                                    @GetStatus(staff)
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-primary me-2" @onclick="() => showEdit(staff)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => showDelete(staff)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between align-items-center flex-wrap">

                    <div class="d-flex align-items-center gap-2">
                        <span class="text-secondary">
                            Showing 1 to 10 of 50 entries
                        </span>

                        <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">

                            <li class="page-item disabled">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            <li class="page-item active">
                                <a class="page-link" href="#">1</a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">2</a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">3</a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>

                </div>

            </div>
        }

    </div>
</div>
@if (showCreateModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background:rgba(0,0,0,.4);backdrop-filter:blur(4px);">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <!-- Copy phần form trong HTML vào đây -->
                <CreateStaff OnCreated="OnSaved" OnCancel="ClosePanels"/>
            </div>
        </div>
    </div>
}
@if (showEditModal && selectedStaff != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background:rgba(0,0,0,.4);backdrop-filter:blur(4px);">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <!-- Copy phần form trong HTML vào đây -->
                <UpdateStaff staffDto="selectedStaff" OnEdited="OnSaved" OnCancel="ClosePanels" />
            </div>
        </div>
    </div>
}
@if (showDeleteModal && selectedStaff != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background:rgba(0,0,0,.4);backdrop-filter:blur(4px);">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <!-- Copy phần form trong HTML vào đây -->
                <DeleteStaff staffId="selectedStaff.StaffId" OnDeleted="OnSaved" OnCancel="ClosePanels" />
            </div>
        </div>
    </div>
}

@code {
    private StaffDashBoardDto? staffs;
    private string searchName = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool showDetailsModal = false;
    private StaffDto? selectedStaff;


    protected override async Task OnInitializedAsync()
    {
        await LoadStaffs();
    }

    private async Task LoadStaffs()
    {
        var requestDto = new StaffDashBoardRequestDto
        {
            PageNumber = currentPage,
            PageSize = pageSize,
            SearchTerm = searchName
        };
        staffs = await StaffService.GetStaffsListAsync(requestDto);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        currentPage = 1;
        await LoadStaffs();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadStaffs();
    }

    private async Task OnSaved()
    {
        await LoadStaffs();
        ClosePanels();
    }

    private void ClosePanels()
    {
        showCreateModal = showEditModal = showDetailsModal = showDeleteModal = false;
        selectedStaff = null;
    }

    private void showCreate()
    {
        showCreateModal = true;
        showEditModal = showDetailsModal = showDeleteModal = false;
        selectedStaff = null;
    }

    private void showEdit(StaffDto staff)
    {
        selectedStaff = staff;
        showEditModal = true;
        showCreateModal = showDetailsModal = showDeleteModal = false;
    }

    private void showDelete(StaffDto staff)
    {
        selectedStaff = staff;
        showEditModal = showCreateModal = showDetailsModal = false;
        showDeleteModal = true;
    }

    private string GetStatus(StaffDto staff)
    {
        if (staff.IsActive && !staff.IsDeleted)
        {
            return "Active";
        } else if (!staff.IsActive && !staff.IsDeleted)
        {
            return "Inactive";
        } else if (staff.IsDeleted)
        {
            return "Deleted";
        }
        else
        {
            return "Unknown";
        }
    }
}