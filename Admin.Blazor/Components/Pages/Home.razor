@page "/"
@rendermode InteractiveServer
@using BLL.DTOs.Order
@using BLL.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IOrderService OrderService
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IProductReviewService ReviewService
@inject IPromotionService PromotionService

@attribute [Authorize(Roles = "Admin")]

<PageTitle>Dashboard - TimeZone Admin</PageTitle>

<div class="vx-page-head">
    <div>
        <h2>Dashboard</h2>
        <p>Store performance overview.</p>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border vx-text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Headline stats -->
    <div class="row g-3 mb-3">
        <div class="col-lg-3 col-6">
            <div class="vx-stat">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="vx-stat-label">Total orders</span>
                    <span class="vx-stat-icon"><i class="bi bi-receipt"></i></span>
                </div>
                <div class="vx-stat-value">@orders.Count</div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="vx-stat">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="vx-stat-label">Revenue (completed)</span>
                    <span class="vx-stat-icon" style="background: var(--vx-success-soft); color: var(--vx-success);"><i class="bi bi-cash-stack"></i></span>
                </div>
                <div class="vx-stat-value">@(orders.Where(o => o.Status == "Completed").Sum(o => o.TotalAmount).ToString("N0")) <span class="fs-6 text-muted fw-normal">đ</span></div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="vx-stat">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="vx-stat-label">Products</span>
                    <span class="vx-stat-icon" style="background: var(--vx-info-soft); color: var(--vx-info);"><i class="bi bi-box-seam"></i></span>
                </div>
                <div class="vx-stat-value">@products.Count(p => !p.IsDeleted)</div>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="vx-stat">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="vx-stat-label">Pending orders</span>
                    <span class="vx-stat-icon" style="background: var(--vx-warning-soft); color: var(--vx-warning);"><i class="bi bi-hourglass-split"></i></span>
                </div>
                <div class="vx-stat-value">@orders.Count(o => o.Status == "Pending")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="vx-stat">
                <span class="vx-stat-label">Categories</span>
                <div class="vx-stat-value">@categories.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vx-stat">
                <span class="vx-stat-label">Flagged reviews</span>
                <div class="vx-stat-value">@reviews.Count(r => r.IsFlagged && !r.IsDeleted) <span class="fs-6 text-muted fw-normal">/ @reviews.Count(r => !r.IsDeleted)</span></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vx-stat">
                <span class="vx-stat-label">Active promotions</span>
                <div class="vx-stat-value">@activePromotions.Count</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Recent orders -->
        <div class="col-12">
            <div class="admin-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0">Recent orders</h5>
                    <a href="orders" class="btn btn-sm btn-outline-secondary">View all</a>
                </div>
                @if (!orders.Any())
                {
                    <p class="text-muted mb-0">No orders yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders.OrderByDescending(o => o.CreatedAt).Take(5))
                                {
                                    <tr>
                                        <td class="small">@order.OrderId.ToString().Substring(0, 8)</td>
                                        <td>@(string.IsNullOrWhiteSpace(order.CustomerName) ? $"Customer #{order.CustomerId}" : order.CustomerName)</td>
                                        <td class="fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                                        <td><span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span></td>
                                        <td class="small text-muted">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<OrderDto> orders = new();
    private List<BLL.DTOs.Product.Staff.ProductStaffDto> products = new();
    private List<BLL.DTOs.Category.CategoryDto> categories = new();
    private List<BLL.DTOs.ProductReview.ProductReviewDto> reviews = new();
    private List<BLL.DTOs.Promotion.PromotionDto> activePromotions = new();

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderService.GetAllOrdersAsync();
        products = await ProductService.GetAllProductsAsync();
        categories = await CategoryService.GetAllCategoriesAsync();
        reviews = await ReviewService.GetAllProductReviewsAsync();
        activePromotions = await PromotionService.GetActiveAndUpcomingPromotionsAsync();
        isLoading = false;
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning-subtle text-warning",
        "Processing" => "bg-info-subtle text-info",
        "Completed" => "bg-success-subtle text-success",
        "Cancelled" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };
}
