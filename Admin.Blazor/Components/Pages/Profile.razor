@page "/profile"
@using Admin.Blazor.Components.Layout
@using BLL.DTOs.Staff
@using BLL.Services.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject IStaffService StaffService
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Profile> Logger

@attribute [Authorize(Roles = "Admin")]

<PageTitle>My Profile - TimeZone Admin</PageTitle>

<ProfileShell Name="@fullName" Active="profile" IsActive="@Input.IsActive">
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="@(SuccessMessage.StartsWith("Failed") ? "vx-flash err" : "vx-flash ok")">
            <i class="bi @(SuccessMessage.StartsWith("Failed") ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i> @SuccessMessage
        </div>
    }

    <form @onsubmit="HandleUpdate" class="vx-panel">
        <div class="vx-panel-head">
            <h2>Personal information</h2>
            <p>This is how your name appears across the admin console.</p>
        </div>

        <div class="vx-panel-body">
            <div class="row g-3">
                <div class="col-md-6 vx-field">
                    <label>Full name</label>
                    <input type="text" class="form-control" @bind="fullName" @bind:event="oninput" placeholder="Your full name" autocomplete="name" />
                </div>

                <div class="col-md-6 vx-field">
                    <label>Role</label>
                    <div class="vx-readonly">
                        <input type="text" class="form-control" value="@RoleText" readonly />
                        <i class="bi bi-lock"></i>
                    </div>
                </div>

                <div class="col-12 vx-field">
                    <label>Work email</label>
                    <div class="vx-readonly">
                        <input type="text" class="form-control" value="@Input.Email" readonly />
                        <i class="bi bi-lock"></i>
                    </div>
                    <div class="vx-help">Your email is your sign-in and can't be changed here.</div>
                </div>
            </div>
        </div>

        <div class="vx-panel-foot">
            <span class="hint">Changes apply to your account immediately.</span>
            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-check2"></i>
                }
                Save changes
            </button>
        </div>
    </form>

    <section class="vx-panel">
        <div class="vx-panel-head">
            <h2>Account details</h2>
            <p>Read-only information about your administrator account.</p>
        </div>
        <div class="vx-panel-body">
            <dl class="vx-info">
                <div>
                    <dt>Status</dt>
                    <dd>@StatusText</dd>
                </div>
                <div>
                    <dt>Member since</dt>
                    <dd>@CreatedAtText</dd>
                </div>
                <div>
                    <dt>Last updated</dt>
                    <dd>@UpdatedAtText</dd>
                </div>
            </dl>
        </div>
    </section>

    <section class="vx-panel">
        <div class="vx-panel-head">
            <h2>Security</h2>
            <p>Keep your administrator account safe.</p>
        </div>
        <div class="vx-panel-foot" style="border-top:0;background:transparent;">
            <span class="hint">Choose a strong password you don't use elsewhere.</span>
            <a href="/auth/change-password" class="btn btn-outline-secondary"><i class="bi bi-lock me-1"></i> Change password</a>
        </div>
    </section>
</ProfileShell>

@code {
    private StaffProfileDto Input { get; set; } = new StaffProfileDto();
    private string? SuccessMessage { get; set; }
    private bool isLoading { get; set; }
    private string StatusText { get; set; } = string.Empty;
    private string RoleText { get; set; } = string.Empty;
    private string CreatedAtText { get; set; } = string.Empty;
    private string UpdatedAtText { get; set; } = string.Empty;
    private bool _initialized = false;
    private string fullName = string.Empty;

    private async Task LoadProfileAsync()
    {
        var email = HttpContextAccessor.HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email)) return;

        var staff = await StaffService.GetByEmailAsync(email);
        if (staff != null)
        {
            Input.StaffId = staff.StaffId;
            Input.Email = staff.Email;
            Input.FullName = staff.FullName;
            fullName = staff.FullName;
            Input.IsActive = staff.IsActive;
            Input.CreatedAt = staff.CreatedAt;
            Input.UpdatedAt = staff.UpdatedAt;
            StatusText = staff.IsActive ? "Active" : "Inactive";
            RoleText = "Administrator"; // Đồng bộ text hiển thị theo ảnh mẫu
            CreatedAtText = staff.CreatedAt.ToString("yyyy-MM-dd");
            UpdatedAtText = staff.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_initialized)
        {
            await LoadProfileAsync();
            _initialized = true;
        }
    }

    private async Task HandleUpdate()
    {
        isLoading = true;
        SuccessMessage = null;
        Input.FullName = fullName;

        var httpContext = HttpContextAccessor.HttpContext;
        var email = httpContext?.User.FindFirst(ClaimTypes.Email)?.Value;
        if (string.IsNullOrEmpty(email))
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var staffId = Input.StaffId;
        if (staffId <= 0)
        {
            Navigation.NavigateTo("/auth/login");
            return;
        }

        var profileDto = new StaffProfileDto
        {
            StaffId = staffId,
            Email = Input.Email,
            FullName = Input.FullName,
            IsActive = Input.IsActive,
            CreatedAt = Input.CreatedAt,
            UpdatedAt = Input.UpdatedAt
        };

        try
        {
            var result = await StaffService.UpdateProfileAsync(staffId, profileDto);
            if (result)
            {
                Input.UpdatedAt = DateTime.UtcNow;
                UpdatedAtText = Input.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never";
                SuccessMessage = "Profile updated successfully.";
                StateHasChanged();
            }
            else
            {
                SuccessMessage = "Failed to update profile.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception while updating profile for staff id {StaffId}", staffId);
            SuccessMessage = "Failed to update profile.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
