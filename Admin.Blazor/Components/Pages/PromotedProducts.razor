@page "/promoted-products"
@rendermode InteractiveServer
@using BLL.DTOs.Promotion
@using BLL.DTOs.ProductVariant
@using BLL.DTOs.Product
@using BLL.Services.Interfaces
@inject IPromotionService PromotionService
@inject IProductVariantService ProductVariantService
@inject IProductService ProductService

<PageTitle>Promoted Products - ElectroNexus</PageTitle>

<style>
    .promo-card {
        transition: transform .12s ease, box-shadow .12s ease;
        cursor: pointer;
    }
    .promo-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 8px 18px rgba(0,0,0,0.12);
    }
    .promo-badge-red { background: #dc3545; color: white; }
    .promo-badge-orange { background: #ff7a00; color: white; }
    .promo-badge-yellow { background: #ffc107; color: #212529; }
    .original-price { text-decoration: line-through; color: #6c757d; }
    .sale-price { font-weight: 700; color: #d6332a; }
    .small-muted { font-size: .85rem; color: #6c757d; }
    .product-image { width: 100%; height: 160px; object-fit: cover; border-radius: 6px; background: #f8f9fa; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="m-0">Promoted Products</h3>
            <div class="small text-muted">All active promotions and calculated discounted prices</div>
        </div>
        <div class="d-flex gap-2">
            <input class="form-control" style="min-width:280px" placeholder="Search by product name..." @bind="searchTerm" @oninput="OnFilterChanged" />
            <select class="form-select" style="width:180px" @bind="selectedFilter">
                <option value="0">All discounts</option>
                <option value="10">&gt; 10%</option>
                <option value="20">&gt; 20%</option>
                <option value="50">&gt; 50%</option>
            </select>
            <button class="btn btn-outline-secondary" @onclick="ResetFilters">Reset</button>
        </div>
    </div>

    @if (loading)
    {
        <div>Loading...</div>
    }
    else if (!viewModels.Any())
    {
        <div class="text-muted">No active promotions available.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var vm in filteredViewModels)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card promo-card h-100 p-2">
                        <img src='@(vm.ImageUrl ?? "/img/placeholder.png")' class="product-image card-img-top" alt="@vm.ProductName" />
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold">@vm.ProductName</div>
                                    <div class="small-muted">Variant: @vm.Variant.Sku • @vm.Variant.Color</div>
                                </div>
                                <div>
                                    <span class="badge @GetBadgeClass(vm.DiscountPercent)">@vm.DiscountPercent.ToString("0")% OFF</span>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="original-price">@vm.OriginalPrice.ToString("N0") $</div>
                                <div class="sale-price">@vm.SalePrice.ToString("N0") $</div>
                            </div>

                            <div class="small text-muted">Reserved: @vm.Promotion.MaxReservedStock • Valid: @vm.Promotion.StartAt.ToLocalTime().ToString("g") — @vm.Promotion.EndAt.ToLocalTime().ToString("g")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private record PromotionProductVm
    {
        public PromotionDto Promotion { get; init; } = default!;
        public ProductVariantDto Variant { get; init; } = default!;
        public string ProductName { get; init; } = string.Empty;
        public string? ImageUrl { get; init; }
        public decimal OriginalPrice => Variant.Price;
        public decimal SalePrice => Promotion.SalePrice;
        public decimal DiscountPercent => OriginalPrice <= 0 ? 0 : Math.Round((OriginalPrice - SalePrice) / OriginalPrice * 100m, 0);
    }

    private List<PromotionProductVm> viewModels = new();
    private IEnumerable<PromotionProductVm> filteredViewModels => ApplyFilters();
    private string searchTerm = string.Empty;
    private int selectedFilter = 0; // 0 = all, 10,20,50 thresholds
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPromotedProductsAsync();
    }

    private async Task LoadPromotedProductsAsync()
    {
        loading = true;
        viewModels.Clear();

        var promotions = await PromotionService.GetAllPromotionsAsync();
        var active = promotions.Where(p => p.StartAt <= DateTime.UtcNow && p.EndAt >= DateTime.UtcNow).ToList();

        // Load all variants once to reduce calls
        var allVariants = await ProductVariantService.GetAllProductVariantsAsync();
        var productCache = new Dictionary<int, ProductDto?>();

        foreach (var p in active)
        {
            var variant = allVariants.FirstOrDefault(v => v.ProductVariantId == p.ProductVariantId);
            if (variant is null) continue;

            if (!productCache.TryGetValue(variant.ProductId, out var product))
            {
                product = await ProductService.GetProductByIdAsync(variant.ProductId);
                productCache[variant.ProductId] = product;
            }

            var vm = new PromotionProductVm
            {
                Promotion = p,
                Variant = variant,
                ProductName = product?.ProductName ?? $"Product #{variant.ProductId}",
                ImageUrl = variant.ImageUrl ?? product?.ImageUrl
            };

            viewModels.Add(vm);
        }

        loading = false;
    }

    private IEnumerable<PromotionProductVm> ApplyFilters()
    {
        var q = viewModels.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var s = searchTerm.Trim();
            q = q.Where(x => x.ProductName.Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        if (selectedFilter > 0)
        {
            q = q.Where(x => x.DiscountPercent > selectedFilter);
        }

        return q.OrderByDescending(x => x.DiscountPercent).ThenBy(x => x.ProductName);
    }

    private void OnFilterChanged(ChangeEventArgs? _ = null)
    {
        // Re-evaluate filteredViewModels via binding; no extra work needed
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        selectedFilter = 0;
        StateHasChanged();
    }

    private string GetBadgeClass(decimal percent)
    {
        if (percent > 50) return "promo-badge-red px-2 py-1 rounded";
        if (percent > 20) return "promo-badge-orange px-2 py-1 rounded";
        if (percent > 10) return "promo-badge-yellow px-2 py-1 rounded";
        return "badge bg-secondary px-2 py-1 rounded";
    }
}